#!/bin/sh
# aparte pre-push — a guard against pushing straight to `main`, nothing else.
#
# Installed by `pnpm install` (root `prepare` -> core.hooksPath=.githooks).
#
# The tests and the build used to run here too, on every branch push (~5 minutes), and
# CI ran them again a minute later on the pull request. CI is where they are judged; a
# push should not wait for a second copy of them. `pnpm gate` still runs everything
# locally when you want the answer before CI gives it.

set -e

# Feature work belongs on a branch + PR, so CI gates it before it lands. The
# release flow legitimately pushes main: export APARTE_ALLOW_MAIN_PUSH=1 for it.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ] && [ "$APARTE_ALLOW_MAIN_PUSH" != "1" ]; then
        printf '\n[aparte] FAIL: direct push to main.\n'
        printf '  Push a branch and open a PR so CI gates it first.\n'
        printf '  Release flow only: APARTE_ALLOW_MAIN_PUSH=1 git push ...\n\n'
        exit 1
    fi
done
