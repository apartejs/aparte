#!/bin/sh
# aparte pre-commit gate — the fast half of `pnpm gate`: lint + typecheck.
#
# Installed by `pnpm install` (the root `prepare` script points
# core.hooksPath at this directory). See CONTRIBUTING.md "The gate".
#
# Both commands are nx-cached / incremental, so a no-op commit costs seconds.
# If one fails, FIX IT — `--no-verify` defeats the entire point of this file.

set -e

# No nx daemon in a hook. With the daemon, a cache hit asks the daemon whether the
# outputs on disk still match, and the daemon answers from a table its file watcher
# keeps — a table that missed the emptying of packages/core/dist often enough that
# `[existing outputs match the cache, left as is]` was printed against an empty
# folder, and every downstream typecheck failed with "Cannot find module
# '@aparte/core'" (see packages/core/project.json). Without the daemon nx hashes
# the outputs from disk and restores them when they differ. A hook is short-lived
# anyway; the daemon saves it nothing.
export NX_DAEMON=false

printf '\n[aparte] pre-commit: lint + typecheck\n'

if ! pnpm lint; then
    printf '\n[aparte] FAIL: lint. Fix it before committing (not --no-verify).\n\n'
    exit 1
fi

if ! pnpm typecheck; then
    printf '\n[aparte] FAIL: typecheck. Fix it before committing (not --no-verify).\n\n'
    exit 1
fi

printf '[aparte] OK: lint + typecheck clean\n\n'
