# Compiled output
dist
out-tsc
tmp

# Dependencies
node_modules

# TypeScript incremental build info — NEVER commit (day-1 lesson from the old repo)
*.tsbuildinfo

# NX
.nx/cache
.nx/workspace-data

# Vite
vite.config.*.timestamp*

# Astro (generated cache/types)
.astro/

# Tests / coverage
coverage
__screenshots__/

# Playwright (browser E2E)
test-results/
playwright-report/
blob-report/
.playwright/

# Claude Code local state — NEVER commit
.claude/

# Per-agent copies of the charter. CLAUDE.md is the one tracked source; a second
# copy (AGENTS.md and friends) drifts the moment a ratified decision is added, and
# one already rode into a commit by accident. Keep yours locally, out of the repo.
AGENTS.md
.codex/

# Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# OS
.DS_Store
Thumbs.db

# Secrets / local env
.env

# Angular CLI cache
.angular/

# Scratch dir for scripts/check-doc-snippets.mjs (kept only when a snippet fails).
.doc-snippets/

# svelte-package build cache
packages/wrappers/*/.svelte-kit/

# Content stamps for scripts/check-dist-freshness.mjs (mtime is not content).
.dist-freshness/

# Raw vitest JSON report (scripts/stamp-test-count.mjs distils it into
# apps/docs/src/data/test-counts.json, which IS committed) and TypeDoc scratch.
.vitest-report.json
apps/docs/.typedoc/
