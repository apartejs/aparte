# Compiled output
dist
out-tsc
tmp

# Dependencies
node_modules

# TypeScript incremental build info — NEVER commit (day-1 lesson from the old repo)
*.tsbuildinfo

# NX
.nx/cache
.nx/workspace-data

# Vite
vite.config.*.timestamp*

# Astro (generated cache/types)
.astro/

# Tests / coverage
coverage
__screenshots__/

# Playwright (browser E2E)
test-results/
playwright-report/
blob-report/
.playwright/

# Claude Code local state — NEVER commit
.claude/

# Per-agent copies of the charter. CLAUDE.md is the one tracked source; a second
# copy (AGENTS.md and friends) drifts the moment a ratified decision is added, and
# one already rode into a commit by accident. Keep yours locally, out of the repo.
AGENTS.md
.codex/

# Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# OS
.DS_Store
Thumbs.db

# Secrets / local env
.env

# Angular CLI cache
.angular/

# Scratch dir for scripts/check-doc-snippets.mjs (kept only when a snippet fails).
.doc-snippets/

# svelte-package build cache
packages/wrappers/*/.svelte-kit/

# Content stamps for scripts/check-dist-freshness.mjs (mtime is not content).
.dist-freshness/

# Raw vitest JSON report, and the count scripts/stamp-test-count.mjs distils out of
# it. Both are build artefacts, and the count was tracked until it earned a churn
# commit per changed number. It does not need to be: CI runs `test:coverage` before
# building the docs in the same job, so the published figure is measured either way,
# and the landing's read sits in a try/catch whose fallback ("more than 1,000 tests",
# plus a file count from its own walk) is the honest answer for a clone that has never
# run the suite. Plus TypeDoc scratch.
.vitest-report.json
apps/docs/src/data/test-counts.json
apps/docs/.typedoc/

# Generated framework bindings — rebuilt from the custom-elements manifest on every
# build, so there is no committed artifact that can fall behind the elements.
packages/*/src/generated/
packages/wrappers/*/src/generated/
# Plugins are one level deeper, and the first two patterns did not reach them — so the
# model-selector's generated bindings were COMMITTED, which is the drifting artifact this
# whole approach exists to avoid.
packages/plugins/*/src/generated/
packages/providers/*/*/src/generated/
packages/locales/*/src/generated/
