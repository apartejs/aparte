{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/nx.json"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "exclude": [
        "apps/docs/**",
        "apps/examples/**",
        "packages/wrappers/angular/**",
        "e2e/**"
      ],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "exclude": [
        "e2e/ssr/**",
        "vitest.config.ts"
      ],
      "options": {
        "buildTargetName": "vite:build",
        "testTargetName": "test",
        "serveTargetName": "serve",
        "devTargetName": "vite:dev",
        "previewTargetName": "vite:preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "vite:typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    }
  ],
  "sync": {
    "applyChanges": true,
    "disabledTaskSyncGenerators": [
      "@nx/js:typescript-sync"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^gen",
        "^build",
        "gen"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/.dist-stamp"
      ]
    },
    "gen": {
      "//": "The generator and the readers it imports are inputs: they live outside every project, so without them a change to the generator alone hit the cache and restored the old output.",
      "dependsOn": [
        "^gen",
        "^build"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/gen-element-bindings.mjs",
        "{workspaceRoot}/scripts/chat-surface.mjs",
        "{workspaceRoot}/scripts/dispatch-sites.mjs",
        "{workspaceRoot}/scripts/wrapper-surface.mjs"
      ],
      "outputs": [
        "{projectRoot}/src/generated"
      ]
    },
    "test": {
      "//": "A wrapper's tests load its generated bindings, as its build and typecheck do. A package's own test target is `vitest run` in its folder, not `@nx/vite:test`: that executor takes `vite.config.ts` (the build's, no `test` block) before `vitest.config.ts`, so the tests ran without their environment and failed, and its reporter printed nothing, a failure included. The root's `vitest.config.ts` is excluded from the vite plugin above: inferred, it was a `test` target running `vitest` in watch mode over the whole workspace, which `nx affected:test` never saw the end of.",
      "dependsOn": [
        "gen"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^gen",
        "gen"
      ],
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "typecheck:tests": {
      "dependsOn": [
        "^build",
        "^gen",
        "gen"
      ],
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    }
  }
}
