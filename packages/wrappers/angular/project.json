{
    "name": "@aparte/angular",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/wrappers/angular/src",
    "projectType": "library",
    "targets": {
        "build": {
            "executor": "nx:run-script",
            "outputs": ["{projectRoot}/dist", "{projectRoot}/.dist-stamp"],
            "options": { "script": "build" }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    "vitest run",
                    { "command": "vitest run --config vitest.server.config.ts", "forwardAllArgs": false }
                ],
                "parallel": false,
                "cwd": "{projectRoot}"
            }
        }
    }
}
