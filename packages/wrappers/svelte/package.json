{
    "name": "@aparte/svelte",
    "version": "0.7.1",
    "description": "Svelte wrapper for apart\u00e9 \u2014 an ergonomic <AparteChat> component plus stores over the framework-agnostic web components. Works on Svelte 4 and 5.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/lib/index.ts",
    "module": "./src/lib/index.ts",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@aparte-workspace/source": "./src/lib/index.ts",
            "types": "./dist/index.d.ts",
            "svelte": "./src/lib/index.ts",
            "default": "./src/lib/index.ts"
        }
    },
    "files": [
        "dist",
        "src/lib",
        "!src/lib/__tests__",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "typecheck:tests": "svelte-check --tsconfig ./tsconfig.check.json --threshold error --output human",
        "dev": "vite",
        "build": "tsc -b --emitDeclarationOnly --force",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "@aparte/core": ">=0.5.0-alpha.0 <1.0.0",
        "svelte": "^4.0.0 || ^5.0.0"
    },
    "devDependencies": {
        "@aparte/core": "workspace:*",
        "@sveltejs/vite-plugin-svelte": "^3.0.0",
        "@testing-library/svelte": "^5.2.0",
        "jsdom": "^22.1.0",
        "svelte": "^4.2.0",
        "svelte-check": "^3.8.0",
        "typescript": "^5.4.0",
        "vite": "^6.0.0"
    },
    "keywords": [
        "svelte",
        "aparte",
        "chat",
        "ai",
        "web-components"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apartejs/aparte.git",
        "directory": "packages/wrappers/svelte"
    },
    "bugs": {
        "url": "https://github.com/apartejs/aparte/issues"
    },
    "svelte": "./src/lib/index.ts"
}
