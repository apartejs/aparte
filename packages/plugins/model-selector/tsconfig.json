{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationDir": "./dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  // `*.spec.ts` and `__tests__/` join `*.test.ts` here for a measured reason: without
  // them `tsc -b --emitDeclarationOnly` wrote `dist/__tests__/element.directives.spec.d.ts`
  // into the PUBLISHED package. The root `tsconfig.tests.json` already covers
  // `packages/plugins/*/src/**/*`, so excluding them here loses no type-checking — it is
  // the same split every other package uses.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"]
}
