{
    "name": "@aparte/plugin-shiki",
    "version": "0.12.1",
    "description": "Syntax highlighting for aparté via shiki — register it as the highlight provider (single lazily-created highlighter).",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@aparte-workspace/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./core": {
            "@aparte-workspace/source": "./src/core.ts",
            "types": "./dist/core.d.ts",
            "import": "./dist/core.js",
            "default": "./dist/core.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -b --emitDeclarationOnly --force",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "@aparte/core": ">=0.12.1 <1.0.0",
        "shiki": "^4.0.0"
    },
    "devDependencies": {
        "@aparte/core": "workspace:*",
        "@shikijs/langs": "^4.0.0",
        "@shikijs/themes": "^4.0.0",
        "shiki": "^4.0.0",
        "typescript": "^5.4.0",
        "vite": "^6.0.0"
    },
    "keywords": [
        "aparte",
        "plugin",
        "highlight",
        "syntax",
        "shiki"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apartejs/aparte.git",
        "directory": "packages/plugins/shiki"
    },
    "bugs": {
        "url": "https://github.com/apartejs/aparte/issues"
    }
}
