{
    "name": "@aparte/plugin-diff",
    "version": "1.6.0",
    "homepage": "https://apartejs.dev/components/diff/",
    "publishConfig": {
        "access": "public"
    },
    "description": "A diff view for aparté — a file change as hunks with old and new line numbers, in the reply or beside it, with comments on a line or a range.",
    "customElements": "dist/custom-elements.json",
    "type": "module",
    "sideEffects": [
        "./dist/*.js",
        "./src/index.ts",
        "./src/aparte-diff.ts"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@aparte-workspace/source": "./src/index.ts",
            "node": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "worker": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "workerd": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "edge-light": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "deno": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "bun": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -b --emitDeclarationOnly --force && pnpm run analyze && node ../../../scripts/stamp-dist.mjs",
        "analyze": "cem analyze",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "@aparte/core": ">=1.6.0 <2.0.0"
    },
    "devDependencies": {
        "@aparte/core": "workspace:*",
        "@custom-elements-manifest/analyzer": "^0.11.0",
        "typescript": "^5.4.0",
        "vite": "^6.0.0"
    },
    "keywords": [
        "aparte",
        "plugin",
        "diff",
        "unified-diff",
        "code-review",
        "patch",
        "web-components"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apartejs/aparte.git",
        "directory": "packages/plugins/diff"
    },
    "bugs": {
        "url": "https://github.com/apartejs/aparte/issues"
    }
}
