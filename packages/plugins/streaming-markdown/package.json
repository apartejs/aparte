{
    "name": "@aparte/plugin-streaming-markdown",
    "version": "0.21.0",
    "homepage": "https://apartejs.dev/plugins/streaming-markdown/",
    "description": "Incremental (token-by-token) Markdown rendering for aparté via @paulrichez/streaming-markdown, with a live URL-scheme guard.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@aparte-workspace/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -b --emitDeclarationOnly --force && node ../../../scripts/stamp-dist.mjs",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@paulrichez/streaming-markdown": "^0.3.0"
    },
    "peerDependencies": {
        "@aparte/core": ">=0.21.0 <1.0.0"
    },
    "devDependencies": {
        "@aparte/core": "workspace:*",
        "typescript": "^5.4.0",
        "vite": "^6.0.0"
    },
    "keywords": [
        "aparte",
        "plugin",
        "markdown",
        "streaming",
        "incremental"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apartejs/aparte.git",
        "directory": "packages/plugins/streaming-markdown"
    },
    "bugs": {
        "url": "https://github.com/apartejs/aparte/issues"
    }
}
