{
    "name": "@aparte/plugin-subagents",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/plugins/subagents/src",
    "projectType": "library",
    "targets": {
        "gen": {
            "//": "`gen` writes the registry and the element specs into `src/generated`, which `build` must not own: `build` owns `dist`. Same shape as model-selector.",
            "outputs": [
                "{projectRoot}/src/generated"
            ]
        },
        "build": {
            "executor": "nx:run-script",
            "outputs": [
                "{projectRoot}/dist",
                "{projectRoot}/.dist-stamp"
            ],
            "options": {
                "script": "build"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest run",
                "cwd": "{projectRoot}"
            }
        },
        "typecheck": {
            "//": "Explicit, so the @nx/js/typescript plugin's inferred one (tsc --build --emitDeclarationOnly, outputs: dist) is not used: that one emits into the dist that build owns and declares it as an output, and a cache hit on it restored a declaration-only snapshot over the full dist. A typecheck writes nothing and claims nothing.",
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc -p tsconfig.json --noEmit",
                "cwd": "{projectRoot}"
            },
            "cache": true,
            "inputs": [
                "default",
                "^production"
            ],
            "outputs": []
        }
    }
}
