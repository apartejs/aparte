{
    "name": "@aparte/plugin-subagents",
    "version": "1.3.0",
    "homepage": "https://apartejs.dev/guides/sub-agents/",
    "publishConfig": {
        "access": "public"
    },
    "description": "Sub-agents for aparté: one line per sub-agent — its name, its task, what it is doing now, how far it got — with its conversation kept out of the reply.",
    "customElements": "dist/custom-elements.json",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@aparte-workspace/source": "./src/index.ts",
            "node": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "worker": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "workerd": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "edge-light": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "deno": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "bun": {
                "types": "./dist/index.node.d.ts",
                "default": "./dist/index.node.js"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -b --emitDeclarationOnly --force && pnpm run analyze && node ../../../scripts/stamp-dist.mjs",
        "analyze": "cem analyze",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "@aparte/core": ">=1.3.0 <2.0.0"
    },
    "devDependencies": {
        "@aparte/core": "workspace:*",
        "@custom-elements-manifest/analyzer": "^0.11.0",
        "typescript": "^5.4.0",
        "vite": "^6.0.0"
    },
    "keywords": [
        "aparte",
        "plugin",
        "sub-agent",
        "subagent",
        "agent",
        "multi-agent",
        "web-components"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apartejs/aparte.git",
        "directory": "packages/plugins/subagents"
    },
    "bugs": {
        "url": "https://github.com/apartejs/aparte/issues"
    }
}
