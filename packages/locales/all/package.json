{
    "name": "@aparte/locales",
    "version": "0.30.0",
    "homepage": "https://apartejs.dev/guides/localization/",
    "description": "The chat’s interface in nine languages for aparté — French, Spanish, Portuguese (Brazil), German, Italian, Russian, Japanese, Korean and Chinese (Simplified). Pass one to aparteGlobalConfig.setLocale(); core ships English.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "@aparte-workspace/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./fr": {
            "@aparte-workspace/source": "./src/fr.ts",
            "types": "./dist/fr.d.ts",
            "import": "./dist/fr.js",
            "default": "./dist/fr.js"
        },
        "./es": {
            "@aparte-workspace/source": "./src/es.ts",
            "types": "./dist/es.d.ts",
            "import": "./dist/es.js",
            "default": "./dist/es.js"
        },
        "./pt-BR": {
            "@aparte-workspace/source": "./src/pt-BR.ts",
            "types": "./dist/pt-BR.d.ts",
            "import": "./dist/pt-BR.js",
            "default": "./dist/pt-BR.js"
        },
        "./de": {
            "@aparte-workspace/source": "./src/de.ts",
            "types": "./dist/de.d.ts",
            "import": "./dist/de.js",
            "default": "./dist/de.js"
        },
        "./it": {
            "@aparte-workspace/source": "./src/it.ts",
            "types": "./dist/it.d.ts",
            "import": "./dist/it.js",
            "default": "./dist/it.js"
        },
        "./ru": {
            "@aparte-workspace/source": "./src/ru.ts",
            "types": "./dist/ru.d.ts",
            "import": "./dist/ru.js",
            "default": "./dist/ru.js"
        },
        "./ja": {
            "@aparte-workspace/source": "./src/ja.ts",
            "types": "./dist/ja.d.ts",
            "import": "./dist/ja.js",
            "default": "./dist/ja.js"
        },
        "./ko": {
            "@aparte-workspace/source": "./src/ko.ts",
            "types": "./dist/ko.d.ts",
            "import": "./dist/ko.js",
            "default": "./dist/ko.js"
        },
        "./zh-CN": {
            "@aparte-workspace/source": "./src/zh-CN.ts",
            "types": "./dist/zh-CN.d.ts",
            "import": "./dist/zh-CN.js",
            "default": "./dist/zh-CN.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -b --emitDeclarationOnly --force && node ../../../scripts/stamp-dist.mjs",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "@aparte/core": ">=0.30.0 <1.0.0"
    },
    "devDependencies": {
        "@aparte/core": "workspace:*",
        "typescript": "~5.7.0",
        "vite": "^6.0.0"
    },
    "keywords": [
        "aparte",
        "locale",
        "i18n",
        "l10n",
        "translations",
        "french",
        "spanish",
        "portuguese",
        "german",
        "italian",
        "russian",
        "japanese",
        "korean",
        "chinese"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/apartejs/aparte.git",
        "directory": "packages/locales/all"
    },
    "bugs": {
        "url": "https://github.com/apartejs/aparte/issues"
    }
}
