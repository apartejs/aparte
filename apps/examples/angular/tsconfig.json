{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    // Declared explicitly, not inferred: TS warns (ts6/`--noEmit` editors included)
    // that a future release will stop guessing the common source directory from the
    // input set, which would silently change the output layout. Every publishable
    // package here already pins it; this example was the one that didn't.
    //
    // `..` (apps/examples), not `./src`: the chat site's shared helpers live in
    // ../_shared, OUTSIDE src/ — main.ts and app.component.ts import them by
    // relative path, the same way every other example does — so the common
    // ancestor of every file actually compiled is the examples folder, not this
    // app's own src/.
    "rootDir": "..",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    // "dom.iterable" added for the chat site: ../_shared/site-shell.ts spreads a
    // `NodeListOf` (`[...view.querySelectorAll(...)]`), which needs it — every other
    // example's tsconfig already carries it, this one just never had a caller that
    // needed the iterable DOM types before.
    "lib": ["ES2022", "dom", "dom.iterable"],
    // ONE Angular. `@aparte/angular` is a workspace link to a package built against
    // Angular 19, its oldest supported major; followed through the link, its imports of
    // `@angular/*` would resolve from ITS node_modules — a second Angular core, in the
    // types (an InputSignal from one copy is not one from the other) and in the bundle.
    // A consumer installing from npm never has that: the package's peers are theirs.
    // These paths give every file, the linked package included, this app's copy — and
    // the Angular CLI's esbuild bundler reads them too.
    "paths": {
      "@angular/*": ["./node_modules/@angular/*"],
      "rxjs": ["./node_modules/rxjs"],
      "rxjs/*": ["./node_modules/rxjs/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
