{
  "name": "@aparte-workspace/docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "gen": {
      "outputs": [
        "{projectRoot}/src/content/docs/reference",
        "{projectRoot}/src/content/docs/components/conversation",
        "{projectRoot}/src/content/docs/components/input",
        "{projectRoot}/src/content/docs/components/shell",
        "{projectRoot}/src/content/docs/components/utility",
        "{projectRoot}/src/content/docs/components/index.mdx",
        "{projectRoot}/src/content/docs/kit",
        "{projectRoot}/src/content/docs/segments",
        "{projectRoot}/src/generated"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/*.mjs",
        "{workspaceRoot}/package.json"
      ]
    },
    "build": {
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/src/content/docs/reference",
        "{projectRoot}/src/content/docs/components/conversation",
        "{projectRoot}/src/content/docs/components/input",
        "{projectRoot}/src/content/docs/components/shell",
        "{projectRoot}/src/content/docs/components/utility",
        "{projectRoot}/src/content/docs/components/index.mdx",
        "{projectRoot}/src/content/docs/kit",
        "{projectRoot}/src/content/docs/segments",
        "{projectRoot}/src/generated"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/*.mjs",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/CHANGELOG.md"
      ]
    }
  }
}
