---
/**
 * The site's sections, beside the search — the row every UI library's docs open with
 * (Docs · Components · Examples), which this site did not have: the header carried a
 * title, a search box and a theme menu, and the kit was a sidebar group among ten.
 *
 * It overrides Starlight's `SocialIcons` slot rather than the whole `Header`, because
 * that slot already sits where the links belong on a wide screen AND in the phone's
 * menu footer, and the header's grid stays Starlight's own. The repository link is the
 * one social icon this site has, so it lives here too.
 */
import { Icon } from '@astrojs/starlight/components';

const LINKS = [
    { label: 'Docs', href: '/guides/getting-started/', section: '/guides/' },
    { label: 'Components', href: '/components/', section: '/components/' },
    { label: 'UI kit', href: '/kit/', section: '/kit/' },
    { label: 'Examples', href: '/examples/chatgpt-like/', section: '/examples/' },
    { label: 'Why aparté', href: '/why/', section: '/why/' },
];

const path = Astro.url.pathname;
---

<nav class="aparte-topnav" aria-label="Sections">
    {LINKS.map(({ label, href, section }) => (
        <a href={href} aria-current={path.startsWith(section) ? 'page' : undefined}>{label}</a>
    ))}
</nav>
<a class="aparte-topnav__repo sl-flex" href="https://github.com/apartejs/aparte" rel="me">
    <span class="sr-only">GitHub</span>
    <Icon name="github" />
</a>

<style>
    .aparte-topnav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.25rem 1.25rem;
    }

    .aparte-topnav a {
        font-size: var(--sl-text-sm);
        font-weight: 500;
        color: var(--sl-color-gray-3);
        text-decoration: none;
        white-space: nowrap;
    }

    .aparte-topnav a:hover,
    .aparte-topnav a[aria-current='page'] {
        color: var(--sl-color-white);
    }

    .aparte-topnav__repo {
        color: var(--sl-color-gray-3);
        padding: 0.5em;
        margin: -0.5em;
    }

    .aparte-topnav__repo:hover {
        color: var(--sl-color-white);
    }
</style>
