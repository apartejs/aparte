---
/**
 * What a working chat weighs, aparté against four other libraries (src/lib/weights.ts). The home
 * shows it compact, its notes and method folded and a link to the full version; the compare page
 * shows it in full. One component, so the two pages cannot print two different numbers.
 */
import { bundles, kb, MEASURED_ON, PINNED_BEFORE, weightOf, WEIGHTS } from '../../lib/weights';
import { REPO_URL } from '../site/sections';
import BarChart from './BarChart.astro';

interface Props {
    /** The home's version: tight bars, the notes and the method behind a disclosure, a link to the compare page. */
    compact?: boolean;
}

const { compact = false } = Astro.props;
const caption = 'JavaScript and CSS a page downloads to start a chat that streams a reply, gzipped.';
const script = `${REPO_URL}/blob/main/scripts/measure-bundles.mjs`;
---

{
    compact ? (
        <div class="weights weights--compact">
            <BarChart compact caption={caption} valueLabel="At startup" rows={WEIGHTS} />
            <details class="weights__more">
                <summary>What each bar holds, and how it is measured</summary>
                <p class="weights__lead">Each library set up from its own docs' quickstart.</p>
                <dl class="weights__notes">
                    {WEIGHTS.map((row) => (
                        <div>
                            <dt>
                                {row.label}: {row.split}
                            </dt>
                            <dd>{row.note}</dd>
                        </div>
                    ))}
                </dl>
                <p class="weights__method">
                    Measured on {MEASURED_ON} with esbuild {bundles.esbuild}: minified, code splitting on, what loads at startup, gzip
                    level {bundles.gzipLevel}; every library at its latest version published before {PINNED_BEFORE}. Loquix and Deep Chat
                    keep their component styles inside their JavaScript; assistant-ui's CSS comes out of your own Tailwind build and is not
                    counted. CopilotKit's build also splits off {kb(weightOf('copilotkit').laterGzip)} of optional chunks (a grammar per
                    highlighted language, diagrams, a developer inspector), fetched only when a reply needs one. A server is never counted.{' '}
                    <a href={script} target="_blank" rel="noopener">
                        The script that measures it ↗
                    </a>
                </p>
            </details>
            <a class="weights__link" href="/compare/#what-a-working-chat-weighs">
                The full comparison →
            </a>
        </div>
    ) : (
        <div class="weights not-content">
            <BarChart
                caption={`${caption} Each library set up from its own docs' quickstart; the line under each bar says what it holds.`}
                valueLabel="At startup"
                rows={WEIGHTS}
            />
            <p class="weights__method">
                Measured on {MEASURED_ON} with esbuild {bundles.esbuild}: minified, code splitting on, what loads at startup, gzip level{' '}
                {bundles.gzipLevel}; every library at its latest version published before {PINNED_BEFORE}. Loquix and Deep Chat keep their
                component styles inside their JavaScript; assistant-ui's CSS comes out of your own Tailwind build and is not counted.
                CopilotKit's build also splits off {kb(weightOf('copilotkit').laterGzip)} of optional chunks (a grammar per highlighted
                language, diagrams, a developer inspector), fetched only when a reply needs one. A server is never counted.{' '}
                <a href={script} target="_blank" rel="noopener">
                    The script that measures it ↗
                </a>
            </p>
        </div>
    )
}

<style>
    .weights {
        display: grid;
        gap: 0.75rem;
        min-width: 0;
    }
    .weights__more {
        color: var(--aparte-text-muted);
        font-size: 0.875rem;
    }
    .weights__more summary {
        width: fit-content;
        margin-inline: auto;
        color: var(--aparte-text);
        cursor: pointer;
        text-decoration: underline;
        text-decoration-color: var(--aparte-primary);
        text-underline-offset: 3px;
    }
    .weights__lead {
        margin: 1rem 0 0;
    }
    .weights__notes {
        display: grid;
        gap: 0.625rem;
        margin: 1rem 0;
    }
    .weights__notes dt {
        color: var(--aparte-text);
        font-weight: 600;
    }
    .weights__notes dd {
        margin: 0;
        line-height: 1.5;
    }
    .weights__method {
        max-width: 50rem;
        margin: 0;
        color: var(--aparte-text-muted);
        font-size: 0.875rem;
        line-height: 1.55;
    }
    .weights__method a,
    .weights__link {
        color: var(--aparte-text);
        text-decoration-color: var(--aparte-primary);
        text-underline-offset: 3px;
    }
    .weights__link {
        justify-self: center;
        font-size: 0.875rem;
        font-weight: 550;
    }
</style>
