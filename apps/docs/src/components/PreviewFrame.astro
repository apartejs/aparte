---
/**
 * The frame itself: the box, its bar, and the three things an iframe cannot do on its own.
 * `ElementPreview`, `SegmentPreview`, `Demo` and the catalogue's `Variant` point it at a
 * document; everything visible lives here so they cannot drift apart.
 *
 * Given `code`, the bar carries Preview / Code: the catalogue shows a variant and the string
 * that renders it in one box, the code a click away. Without it the frame is the preview alone
 * and the page prints the code itself (the guides, the generated pages).
 *
 * The bar is the kit's: segmented `.aparte-btn-group`s — `aria-selected` under a tablist for
 * the view, `aria-pressed` for the width.
 * The intent is named (`--neutral`) rather than left to the default: a selected segment with no
 * intent class is painted neutral but keeps the default dark ink, 3.38:1 in the light theme.
 *
 * ONE RENDER, FIVE FRAMEWORKS, and it is deliberate. Every wrapper mounts the same custom
 * elements, so five frames would render five identical documents and prove the same thing
 * five times; claiming the rendering differs is the lie worth avoiding.
 */
import { externalLinkIcon } from '@aparte/core/icons';
import Code from './content/Code.astro';

interface Props {
    /** The preview document to load. */
    src: string;
    /** What the frame is announced as to a screen reader. */
    label: string;
    /** One sentence under the frame saying what is being shown. */
    caption?: string;
    /** The string that renders this preview: adds a Code view to the bar. */
    code?: string;
    /** The code's language (default `html`). */
    lang?: string;
    /**
     * The frame's height before its document reports one, in px. Without it the frame starts at
     * the 10rem floor and grows when the demo loads, pushing everything under it down.
     */
    height?: number;
    /** The 375 / 768 / Full presets (default on); off where the frame is narrower than 768 anyway. */
    widths?: boolean;
}

const { src, label, caption, code, lang = 'html', height, widths = true } = Astro.props;
const id = `preview-${Math.random().toString(36).slice(2, 8)}`;
---

{/* `not-content` is Starlight's own opt-out of the prose flow, and this figure is not prose:
    Starlight's `* + *` rule would push every button after the first down by 1rem. */}
<figure class="aparte-preview not-content">
    <div class="aparte-preview-bar">
        {
            code && (
                <div class="aparte-btn-group" role="tablist" aria-label="View">
                    <button class="aparte-btn aparte-btn--surface aparte-btn--neutral aparte-btn--sm" type="button" role="tab" id={`${id}-tab-preview`} aria-controls={`${id}-preview`} aria-selected="true" data-view="preview">Preview</button>
                    <button class="aparte-btn aparte-btn--surface aparte-btn--neutral aparte-btn--sm" type="button" role="tab" id={`${id}-tab-code`} aria-controls={`${id}-code`} aria-selected="false" tabindex="-1" data-view="code">Code</button>
                </div>
            )
        }
        {/* Presets over a free drag handle: the point is to reach the breakpoints core actually
            declares, and 375 is the one a reader cannot hit by dragging inside a documentation
            column. The handle stays for everything in between. */}
        {
            widths && (
                <div class="aparte-btn-group aparte-preview-widths" role="group" aria-label="Preview width">
                    <button class="aparte-btn aparte-btn--surface aparte-btn--neutral aparte-btn--sm" type="button" data-width="375" aria-pressed="false">375</button>
                    <button class="aparte-btn aparte-btn--surface aparte-btn--neutral aparte-btn--sm" type="button" data-width="768" aria-pressed="false">768</button>
                    <button class="aparte-btn aparte-btn--surface aparte-btn--neutral aparte-btn--sm" type="button" data-width="0" aria-pressed="true">Full</button>
                </div>
            )
        }
        <a class="aparte-btn aparte-btn--ghost aparte-btn--sm aparte-preview-open" href={src} target="_blank" rel="noopener">
            Open
            <span class="aparte-preview-open__glyph" set:html={externalLinkIcon} />
        </a>
    </div>
    <div class="aparte-preview-frame" id={`${id}-preview`} role={code ? 'tabpanel' : undefined} aria-labelledby={code ? `${id}-tab-preview` : undefined}>
        <iframe title={label} loading="lazy" src={src} style={height ? `height: ${height}px` : undefined}></iframe>
    </div>
    {
        code && (
            <div class="aparte-preview-code" id={`${id}-code`} role="tabpanel" aria-labelledby={`${id}-tab-code`} hidden>
                <Code code={code} lang={lang} />
            </div>
        )
    }
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    .aparte-preview {
        margin: 1.5rem 0;
    }

    .aparte-preview-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--aparte-space-2);
        margin-bottom: var(--aparte-space-2);
    }

    .aparte-preview-open {
        margin-inline-start: auto;
        gap: var(--aparte-space-1);
    }

    .aparte-preview-open__glyph {
        display: inline-flex;
        --aparte-icon-size: 0.85rem;
    }

    /* `resize: horizontal` needs a non-visible overflow to show the handle. The width is the
       reader's to change, so it is not clamped beyond the column. */
    .aparte-preview-frame {
        overflow: hidden;
        resize: horizontal;
        min-width: 20rem;
        max-width: 100%;
        border: var(--aparte-border-width) solid var(--aparte-border);
        border-radius: var(--aparte-radius-lg);
        background: var(--aparte-bg);
    }

    .aparte-preview-frame[hidden] {
        display: none;
    }

    .aparte-preview-code :global(.aparte-doc-code) {
        margin: 0;
    }

    .aparte-preview-frame iframe {
        display: block;
        width: 100%;
        /* A floor until the frame reports its own height, so the box never collapses to
           nothing on a slow load. The cap is applied in script: it has to beat the height the
           frame asks for. And no transition on the height: a frame that trails its content by
           200ms is the wrong height for 200ms, which showed as a scrollbar mid-drag. */
        height: 10rem;
        border: 0;
    }

    .aparte-preview figcaption {
        margin-top: var(--aparte-space-2);
        font-size: var(--aparte-font-size-sm);
        color: var(--aparte-text-muted);
    }
</style>

<script>
    /*
     * Four jobs, none of which an iframe does on its own.
     *
     * The height, because the frame is the only one that knows it and a fixed height either
     * crops the demo or leaves a band of empty stage under it.
     *
     * The theme, because the frame is a separate document: it reads the stored choice itself
     * before paint, but a reader who toggles WHILE it is open would otherwise be looking at a
     * light demo inside a dark page.
     *
     * The width presets, because core declares breakpoints and a preview that cannot reach
     * them does not demonstrate them. And the view, Preview or Code, where the bar has one.
     */
    const MIN_HEIGHT = 96;
    const MAX_HEIGHT = 640;

    addEventListener('message', (event: MessageEvent) => {
        const height = (event.data as { apartePreviewHeight?: number })?.apartePreviewHeight;
        if (typeof height !== 'number') return;
        for (const frame of document.querySelectorAll('.aparte-preview iframe')) {
            if (frame instanceof HTMLIFrameElement && frame.contentWindow === event.source) {
                frame.style.height = `${Math.min(Math.max(height, MIN_HEIGHT), MAX_HEIGHT)}px`;
            }
        }
    });

    /* Ask, rather than wait to be told. This script is a module and therefore deferred, while
       a frame above the fold starts loading during parse — so its first height message can be
       sent before the listener above exists. Asking on load covers the frames that beat us to
       it; asking again immediately covers the ones that had already finished. */
    for (const frame of document.querySelectorAll<HTMLIFrameElement>('.aparte-preview iframe')) {
        const ask = () => frame.contentWindow?.postMessage({ aparteWantHeight: true }, '*');
        frame.addEventListener('load', ask);
        ask();
    }

    /* The site writes the reader's choice to `data-theme` on the root. Watching the attribute
       rather than a control's click keeps this working whatever the control is. */
    new MutationObserver(() => {
        const theme = document.documentElement.dataset.theme ?? 'auto';
        for (const frame of document.querySelectorAll<HTMLIFrameElement>('.aparte-preview iframe')) {
            frame.contentWindow?.postMessage({ aparteTheme: theme }, '*');
        }
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    for (const figure of document.querySelectorAll<HTMLElement>('.aparte-preview')) {
        const box = figure.querySelector<HTMLElement>('.aparte-preview-frame');
        const widths = figure.querySelectorAll<HTMLButtonElement>('[data-width]');
        for (const button of widths) {
            button.addEventListener('click', () => {
                const width = Number(button.dataset.width);
                if (box) box.style.width = width ? `${width}px` : '';
                for (const other of widths) other.setAttribute('aria-pressed', String(other === button));
            });
        }

        const views = [...figure.querySelectorAll<HTMLButtonElement>('[data-view]')];
        const show = (view: HTMLButtonElement) => {
            for (const tab of views) {
                const on = tab === view;
                tab.setAttribute('aria-selected', String(on));
                tab.tabIndex = on ? 0 : -1;
                const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
                if (panel) panel.hidden = !on;
            }
            // Widths only mean something on the preview.
            figure.querySelector<HTMLElement>('.aparte-preview-widths')?.toggleAttribute('hidden', view.dataset.view !== 'preview');
        };
        for (const tab of views) {
            tab.addEventListener('click', () => show(tab));
            tab.addEventListener('keydown', (event) => {
                if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
                event.preventDefault();
                const next = views[(views.indexOf(tab) + (event.key === 'ArrowRight' ? 1 : -1) + views.length) % views.length]!;
                next.focus();
                show(next);
            });
        }
    }
</script>
