---
/**
 * The page's title, and under it the page's own description in a quieter voice.
 *
 * Every page already carries a one-sentence `description` in its frontmatter — written
 * for search results, so it says what the page is for — and Starlight only put it in a
 * meta tag. A reader landing on a page met the title and then the first paragraph of the
 * body, which on the generated pages is a class name. Shown here, the sentence does the
 * job a lede does on the docs this site is compared with: what you are about to read,
 * before any of it.
 */
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="aparte-lede">{description}</p>}

<style>
    h1 {
        margin-top: 1rem;
        font-size: var(--sl-text-h1);
        line-height: var(--sl-line-height-headings);
        font-weight: 600;
        color: var(--sl-color-white);
    }

    .aparte-lede {
        margin-top: 0.75rem;
        max-width: 42rem;
        font-size: var(--sl-text-lg);
        line-height: 1.55;
        color: var(--sl-color-gray-3);
    }
</style>
