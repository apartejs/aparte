---
/*
 * Starlight's own <Head>, plus the card it already promises.
 *
 * Starlight sets `twitter:card: summary_large_image` on every page — a request for a wide
 * image — and shipped no `og:image` to satisfy it. The card rendered EMPTY, which reads
 * worse than declaring nothing at all: the platform reserves the space and shows a blank.
 *
 * The image URL is derived from the page's own id, so it matches the route generated in
 * `src/pages/og/[...slug].ts`. A component override rather than a `head` entry in the
 * config, because a config entry is one constant for the whole site — every link would
 * share the same picture, which is the failure this is meant to fix.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import { ogSlug } from '../lib/og-slug';
import { CHANGELOG_COMPARE } from '../lib/changelog-compare.mjs';
import { UMAMI_DOMAINS, UMAMI_SRC, UMAMI_WEBSITE_ID } from '../data/analytics';
import FontPreload from './site/FontPreload.astro';

const { entry } = Astro.locals.starlightRoute as StarlightRouteData;

// The same rule the generating route uses — see src/lib/og-slug.ts for why it is shared.
const image = new URL(`/og/${ogSlug(entry.id)}.png`, Astro.site).href;

// The card is generated FROM this page's title and description, so describing it is
// not a second piece of copy to maintain — it is the same sentence, said to a screen
// reader on the platforms that surface it.
const imageAlt = `aparté — ${entry.data.title}`;
---

<Default><slot /></Default>
<FontPreload />
{CHANGELOG_COMPARE.test(Astro.url.pathname) && <meta name="robots" content="noindex, follow" />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- The library's own pieces on the page (callouts, code blocks) follow the reader's theme:
     Starlight writes `data-theme` on <html>, the library reads `data-aparte-theme`. Starlight
     always resolves "auto" to a concrete value, so mirroring it is exact; the observer follows
     every later toggle. -->
<script is:inline>
  (() => {
    const root = document.documentElement;
    const sync = () => {
      const theme = root.getAttribute('data-theme');
      if (theme === 'light' || theme === 'dark') root.setAttribute('data-aparte-theme', theme);
    };
    sync();
    new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>

<!-- The copy button every code block carries (src/lib/markdown.mjs). One delegated listener
     for the whole page; the button says it worked the way the chat's own code block does,
     with a check for a moment. -->
<script is:inline>
  document.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-copy-code]') : null;
    if (!button) return;
    const code = button.closest('.aparte-segment-code')?.querySelector('pre')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(code);
      button.setAttribute('data-copied', '');
      button.setAttribute('aria-label', 'Copied');
      setTimeout(() => {
        button.removeAttribute('data-copied');
        button.setAttribute('aria-label', 'Copy');
      }, 1500);
    } catch {
      // A browser that refuses the clipboard leaves the code selectable; nothing to undo.
    }
  });
</script>

<!-- Self-hosted Umami, on every docs page. Here rather than in the config's `head`
     array because that array is Starlight's alone and would still miss the landing,
     so the site would need two mechanisms for one tag; this file is already the
     per-page head and the landing already has its own. See src/data/analytics.ts. -->
{import.meta.env.PROD && (
  <script is:inline defer src={UMAMI_SRC} data-website-id={UMAMI_WEBSITE_ID} data-domains={UMAMI_DOMAINS}></script>
)}
