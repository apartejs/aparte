---
/**
 * `@aparte/plugin-katex` for a demo frame, installed here: `setupKatex()` takes nothing a demo
 * would choose. KaTeX's stylesheet comes with it, as an app imports it.
 */
---

<script>
    import 'katex/dist/katex.min.css';
    import { setupKatex } from '@aparte/plugin-katex';

    setupKatex();
</script>
