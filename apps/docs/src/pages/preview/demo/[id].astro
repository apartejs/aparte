---
/**
 * One standalone document per GUIDE scenario, for `<Demo>` to load in its frame.
 *
 * Deliberately the same shape as `preview/[tag].astro`: a list, `getStaticPaths`, the
 * script split out so `PreviewDocument` can revive it after the library has loaded. The
 * only difference is where the string comes from — the demo registry (src/data/demos/) rather than an
 * element's `@example` — because a guide illustrates a STATE, not an element.
 */
import { DEMOS } from '../../../data/demos';
import PreviewDocument from '../../../components/PreviewDocument.astro';

export function getStaticPaths() {
    return DEMOS.map((demo) => ({ params: { id: demo.id }, props: demo }));
}

const { title, html, plugins } = Astro.props;

const SCRIPT = /<script\b[^>]*>([\s\S]*?)<\/script>/gi;
const scripts = [...html.matchAll(SCRIPT)].map((match) => match[1] ?? '');
const markup = html.replace(SCRIPT, '').trim();

/*
 * A `<dialog>` without `open` is `display: none`: the dialog demo drew its trigger button
 * and nothing else — 1.4% of the scene at 375 — and nothing in it answered the width.
 * The class preview already opens its dialog modally on arrival (`class/[slug].astro`);
 * a demo that carries one gets the same, and the code a reader copies keeps no `open`.
 *
 * Opened with the `open` attribute, not `showModal()`: showModal() runs the dialog's focusing
 * steps, which move the focus into the frame on load — the components overview's first three Tab
 * presses landed in this dialog's tile. In the flow (`position: relative`) rather than where the UA
 * puts a non-modal dialog, which was on top of its own trigger. The trigger still opens it modally.
 */
if (/class="aparte-dialog"/.test(markup)) {
    scripts.push("const d = document.querySelector('dialog.aparte-dialog'); if (d) { d.setAttribute('open', ''); d.style.position = 'relative'; }");
}
---

<PreviewDocument title={`${title} — live demo`} markup={markup} scripts={scripts} plugins={plugins} />
