---
/**
 * One standalone document per class family, for `ClassPreview` to load in its frame.
 *
 * The markup is the example from the stylesheet's own header comment, verbatim — the same
 * string the reference prints as code. There is no script: these are classes, not
 * components, and that is the point the frame makes better than a sentence could.
 */
import { CLASS_PREVIEWS } from '../../../generated/class-previews';
import PreviewDocument from '../../../components/PreviewDocument.astro';

export function getStaticPaths() {
    return CLASS_PREVIEWS.map((preview) => ({ params: { slug: preview.slug }, props: preview }));
}

const { name, markup, slug } = Astro.props;

/*
 * One family cannot be seen from its markup alone: a `<dialog>` without `open` is
 * `display: none`, so the Dialog preview showed its trigger button and nothing else —
 * "a recipe you cannot see is a list of names", on the one page that says so. The
 * frame opens it on arrival with the `open` attribute: the box shown in the flow, above its
 * trigger, with no backdrop. It used to open it modally, which looks closer to what the button
 * gives — but `showModal()` runs the focusing steps, so loading a page moved the reader's
 * focus into this frame (axe and a Tab walk, 2026-10-16). The button still opens it modally,
 * once Cancel has closed it. The frame
 * keeps a floor of height for it (PreviewDocument). The code block a reader copies stays
 * the sheet's own example, with no `open` hardcoded.
 */
const scripts = slug === 'dialog'
    ? ["const d = document.querySelector('dialog.aparte-dialog'); if (d) { d.setAttribute('open', ''); d.style.position = 'relative'; }"]
    : [];
---

<PreviewDocument title={`${name} classes — live preview`} markup={markup} scripts={scripts} />
