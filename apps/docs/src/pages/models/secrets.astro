---
import Landing from '../../layouts/Landing.astro';
import { bundled } from '../../lib/bundled-model';
import { SECRETS_RUNTIMES } from '../../data/model-runtimes';
import '../../styles/model-page.css';

/*
 * The product page of aparte-secrets, on the frame of /models/titler/ and under the same two
 * rules: nothing typed that can be measured (the size is `stat`ed from the file the site
 * installs, the version read from the package, the latency measured in the reader's tab),
 * and the limits said on the page before the reader finds them — above all that it is
 * noisier than a pattern scanner on clean code, which is why it goes beside one.
 *
 * The values in the examples are invented and match no provider's format: a scanner that
 * reads this site finds a password in a sentence, which is the point being made.
 */
const SECRETS = bundled('@aparte/secrets');

/** Six messages: four secrets, one config line, one that only talks about a password. */
const EXAMPLES = [
    { lang: 'en', text: 'the wifi password is Sunflower77# for the guests' },
    { lang: 'fr', text: "Le mot de passe du wifi, c'est Mirabelle-2019, ne le donne à personne." },
    { lang: 'fr', text: 'Voici ma clé API pour le service météo : 7tKq2LmX9vRb4NzW8pYc3HdF, elle ne marche plus.' },
    { lang: 'en', text: 'the bot token is xK9mQ2vL8pR4tW7nZ3bF, can you tell me why the webhook fails?' },
    { lang: 'en', text: 'Here is my config: DB_USER=admin DB_PASS=Galaxy-Orbit-42' },
    { lang: 'en', text: 'I forgot my password again, how do I reset it?' },
];

const TITLE = 'aparte-secrets — find passwords and API keys, no API call';
const DESCRIPTION =
    `Finds the passwords, API keys and tokens in a message by reading their context, and masks `
    + `them before it is sent: ${SECRETS.kb} KB, no API call. Try it in your browser.`;
/** Written from the entry in src/pages/og/[...slug].ts; change one and change the other. */
const IMAGE_ALT =
    'A dark card with a brass edge and the aparté mascot, headed “A password in a message, caught '
    + 'before it is sent”, over the line “aparte-secrets reads the context around a value, so it '
    + 'finds the passwords and keys a pattern scanner misses. 200 KB, nothing leaves the page.”';
---

<Landing
  title={TITLE}
  description={DESCRIPTION}
  canonical="https://apartejs.dev/models/secrets/"
  ogImage="https://apartejs.dev/og/models/secrets.png"
  ogImageAlt={IMAGE_ALT}
>
  <div class="mp">
    <header class="mp-head">
      <p class="eyebrow"><a href="/models/">Models</a> &mdash; <b>aparte-secrets {SECRETS.version}</b></p>
      <h1 class="thesis serif">A password in a message, <em>caught</em> before it is sent.</h1>
      <p class="lede">
        aparte-secrets finds passwords, API keys, tokens and private keys in text. It reads the value
        <b>and what is said around it</b>, so it finds what a pattern scanner has no rule for &#8212;
        a password in a sentence, the key of a provider nobody listed &#8212; and leaves hashes, UUIDs
        and placeholders alone. <b>{SECRETS.kb} KB</b>, a few milliseconds, nothing leaves the page.
      </p>
    </header>

    <!-- ── the demo: the top of the page, and the address to give ── -->
    <section class="demo" id="demo" aria-label="Try the model" data-file={`int8 · ${SECRETS.kb} KB`}>
      <div class="demo-card">
        <div class="demo-in">
          <label class="lab" for="sc-msg">A message</label>
          <textarea id="sc-msg" rows="4" spellcheck="false" autocomplete="off"
            placeholder="Type a message with a password or a key in it…"></textarea>
          <div class="examples" role="group" aria-label="Or try one of these">
            {EXAMPLES.map((e) => (
              <button type="button" class="ex" data-text={e.text}>
                <span class="ex-lang" aria-hidden="true">{e.lang}</span>
                <span class="ex-text">{e.text}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="demo-out">
          <p class="lab">What the model found</p>
          <p class="found" data-sd-found></p>
          <p class="lab">What is sent instead</p>
          <p class="masked" data-sd-masked></p>
          <p class="meter" aria-live="polite" data-sd-state>Loading the model, {SECRETS.kb} KB&hellip;</p>
        </div>
      </div>
      <p class="demo-note">
        Everything above is the model&#8217;s, computed in this tab as you type: what it found, and
        the placeholders <code>mask()</code> puts in its place. Every value in the examples is
        invented. The latency is measured here, not quoted.
      </p>
    </section>

    <!-- ── the numbers ──────────────────────────────────────────────────── -->
    <section class="band">
      <h2 class="serif">What it <span class="paren">(</span>weighs<span class="paren">)</span></h2>
      <div class="figures">
        <div class="fig"><b>{SECRETS.kb} KB</b><span>the file<em>int8 &#8212; English and French</em></span></div>
        <div class="fig"><b>0.76</b><span>F1 on chat messages<em>written after training &#8212; OpenAI&#8217;s privacy-filter 0.53, gitleaks 0.29</em></span></div>
        <div class="fig"><b>0.85</b><span>line F1 on CredData<em>Samsung&#8217;s public benchmark &#8212; gitleaks 0.39</em></span></div>
        <div class="fig"><b data-sd-ms>&#8230; ms</b><span>per message, one core<em>measured above, in your tab</em></span></div>
        <div class="fig"><b>0</b><span>network calls<em>after the file: the model runs in the page</em></span></div>
        <div class="fig"><b>0</b><span>dependencies<em>in the browser and Node</em></span></div>
      </div>
      <p class="sec-note">
        On clean code it is noisier than a pattern scanner: 0.17 false alerts per 1,000 lines,
        against 0.02 for gitleaks. Every test set and every number are on the
        <a href="https://huggingface.co/apartejs/aparte-secrets" target="_blank" rel="noopener">model card &#8594;</a>
      </p>
    </section>

    <!-- ── use it in a chat ─────────────────────────────────────────────── -->
    <section class="band">
      <h2 class="serif">Before the message <span class="paren">(</span>leaves<span class="paren">)</span></h2>
      <p class="sec-sub">
        Mask the message, send the masked text, and put the values back into the answer &#8212;
        all three on the client. A value found once is masked everywhere it appears.
      </p>
      <div class="code"><pre><code><span class="kw">import</span> {'{'} loadSecrets {'}'} <span class="kw">from</span> <span class="st">'@aparte/secrets'</span>;

<span class="kw">const</span> secrets = <span class="kw">await</span> <span class="fn">loadSecrets</span>();
<span class="kw">const</span> {'{'} text, secrets: map {'}'} = secrets.<span class="fn">mask</span>(message);   <span class="cm">// "[PASSWORD_1]" in place of the value</span>
<span class="kw">const</span> answer = <span class="kw">await</span> <span class="fn">askTheModel</span>(text);                 <span class="cm">// the secret never leaves the device</span>
secrets.<span class="fn">unmask</span>(answer, map);                            <span class="cm">// the values back, locally</span></code></pre></div>
      <p class="sec-note">
        <code>npm install @aparte/secrets</code> &#8212; once your app is bundled, serve the model
        file yourself and pass it in: with Vite, <code>import modelUrl from '@aparte/secrets/model?url'</code>,
        then <code>loadSecrets(modelUrl)</code>. For names, emails and phone numbers, run
        <a href="/models/privacy/">aparte-privacy</a> on the same text.
      </p>
    </section>

    <!-- ── use it on a repository ───────────────────────────────────────── -->
    <section class="band">
      <h2 class="serif">In your <span class="paren">(</span>repository<span class="paren">)</span></h2>
      <p class="sec-sub">
        The same model scans files and commits, on your machine or on the CI runner, with no
        network call. It finds what has no fixed format, so it goes beside gitleaks or secretlint,
        not instead of them. Values are redacted in every output.
      </p>
      <div class="code"><pre><code>npx @aparte/secrets-cli                 <span class="cm"># every file git tracks</span>
npx @aparte/secrets-cli --staged        <span class="cm"># only what the next commit adds</span></code></pre></div>
      <p class="sec-sub">On GitHub, each finding becomes an annotation on its line of the pull request:</p>
      <div class="code"><pre><code><span class="kw">steps</span>:
  - <span class="kw">uses</span>: <span class="st">actions/checkout@v5</span>
  - <span class="kw">uses</span>: <span class="st">apartejs/aparte-secrets-action@v1</span></code></pre></div>
      <p class="sec-note">
        Also as a <a href="https://pre-commit.com" target="_blank" rel="noopener">pre-commit</a> hook
        (<code>id: aparte-secrets</code>) and as a
        <a href="https://www.npmjs.com/package/@aparte/secretlint-rule-secrets" target="_blank" rel="noopener">secretlint rule</a>.
        Options, baselines and SARIF output: the
        <a href="https://www.npmjs.com/package/@aparte/secrets-cli" target="_blank" rel="noopener">CLI</a>
        and the <a href="https://github.com/apartejs/aparte-secrets-action" target="_blank" rel="noopener">Action</a>.
      </p>
    </section>

    <!-- ── where it runs: one runtime per platform, same spans ──────────── -->
    <section class="band" id="runtimes">
      <h2 class="serif">Where it <span class="paren">(</span>runs<span class="paren">)</span></h2>
      <p class="sec-sub">
        One model, one runtime per language. Each reads the same file and finds the same spans,
        with the same categories and the same scores.
      </p>
      <dl class="mp-facts runtimes">
        {SECRETS_RUNTIMES.map((runtime) => (
          <>
            <dt><a href={runtime.href} target="_blank" rel="noopener">{runtime.language}</a></dt>
            <dd>
              {runtime.platforms}
              <span class="runtime-install">{runtime.installNote && `${runtime.installNote}: `}<code>{runtime.install}</code></span>
            </dd>
          </>
        ))}
      </dl>
      <p class="sec-sub">In Swift, <code>AparteSecrets</code> brings the runtime and the model:</p>
      <div class="code"><pre><code><span class="kw">import</span> AparteSecrets

<span class="kw">let</span> secrets = <span class="kw">try</span> Secrets.<span class="fn">load</span>()   <span class="cm">// load once, share across threads</span>
secrets.<span class="fn">detect</span>(<span class="st">"the wifi password is Sunflower77# for the guests"</span>)</code></pre></div>
      <p class="sec-note">
        In Xcode, <i>File &#8594; Add Package Dependencies&#8230;</i> and paste the repository URL.
      </p>
      <p class="sec-sub">In Kotlin, on Android or the JVM:</p>
      <div class="code"><pre><code><span class="kw">import</span> dev.apartejs.secrets.Secrets

<span class="kw">val</span> secrets = Secrets.<span class="fn">load</span>()   <span class="cm">// load once, share across threads</span>
secrets.<span class="fn">detect</span>(<span class="st">"the wifi password is Sunflower77# for the guests"</span>)</code></pre></div>
      <p class="sec-note">
        Add <code>dev.apartejs:secrets</code> to your Gradle dependencies; it is usable from Java
        too. On Android, load it off the main thread.
      </p>
    </section>

    <!-- ── what it is, and is not ───────────────────────────────────────── -->
    <section class="band">
      <h2 class="serif">What it <span class="paren">(</span>is<span class="paren">)</span>, and is not</h2>
      <dl class="mp-facts">
        <dt>Context, not patterns</dt>
        <dd>It reads the words around a value: a random-looking string is a key when the text says it is one. That is how it finds passwords and unknown providers, and why a key pasted alone, with nothing said about it, is harder for it.</dd>
        <dt>Beside a scanner</dt>
        <dd>On clean code it raises more false alerts than gitleaks or detect-secrets, which only report the formats they know. In chat, about one alert in four is not a secret. Use it for what they miss, next to them.</dd>
        <dt>Boundaries</dt>
        <dd>A trailing symbol or a punctuation-heavy value can be cut a character short or long. Escaped JSON reads worse than plain text.</dd>
        <dt>English and French</dt>
        <dd>The only languages it is tested on. The chat test sets are synthetic &#8212; secrets written into real messages; CredData and the clean repositories are the independent references.</dd>
        <dt>Open</dt>
        <dd>MIT, code and weights. A Python reference reader is published beside the model, and every runtime gives the same spans as it on the reference texts. No secret, even an invented one, lives in the code repository: the test texts are on Hugging Face.</dd>
      </dl>
      <p class="st-links">
        <a href="https://huggingface.co/apartejs/aparte-secrets" target="_blank" rel="noopener">The model card &#8594;</a>
        <a href="https://github.com/apartejs/aparte-secrets-model" target="_blank" rel="noopener">The code &#8594;</a>
        <a href="https://www.npmjs.com/package/@aparte/secrets" target="_blank" rel="noopener">On npm &#8594;</a>
        <a href="https://github.com/apartejs/aparte-secrets-swift" target="_blank" rel="noopener">For Swift &#8594;</a>
        <a href="https://github.com/apartejs/aparte-secrets-kotlin" target="_blank" rel="noopener">For Kotlin &#8594;</a>
        <a href="https://github.com/apartejs/aparte-secrets-action" target="_blank" rel="noopener">The GitHub Action &#8594;</a>
      </p>
    </section>
  </div>

  <script>
    // The real package, the one a consumer installs. Its model file is passed in by URL, the
    // way its README asks of a bundled app: the bundler copies it as an asset of this site, so
    // the fetch is same-origin.
    import { loadSecrets } from '@aparte/secrets';
    import modelUrl from '@aparte/secrets/model?url';
    import { mountSpanDemo } from '../../lib/span-demo';

    mountSpanDemo(document.getElementById('demo')!, loadSecrets(modelUrl), {
        password: 'password',
        api_key: 'API key',
        token: 'token',
        private_key: 'private key',
        other: 'secret',
    });
  </script>
</Landing>
