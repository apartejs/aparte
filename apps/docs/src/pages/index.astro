---
import { readFileSync, readdirSync } from 'node:fs';
import { LANDING_TITLE, LANDING_DESCRIPTION, LANDING_IMAGE_ALT } from '../data/landing-meta';
import '../styles/palette.css';
import '../styles/landing.css';

/*
 * The landing page.
 *
 * It used to say ONE thing, four times: "framework-agnostic", in the eyebrow, the
 * lede, the facts row and a whole section of framework tabs. That is portability —
 * a property, not a benefit — and it is also, word for word, the closest
 * competitor's own positioning, so leading with it put aparté second on someone
 * else's argument. Meanwhile the things no presentational component kit can have
 * (a tool loop that pauses for a human, ten kinds of content in one turn, a
 * sandboxed artifact preview, branch-and-retry) were nowhere on the page.
 *
 * Every number and capability below was verified against the source before it was
 * written here, and several drafts were cut for failing that check: there is no
 * bundle-size figure (nothing in the repo measures one), the CSS-variable count is
 * 249 and not 250, `provider-openai-compat` ships six presets and not eight, and
 * the wrappers' slots are equivalent but not identical, so the page does not claim
 * they are. When in doubt the sentence says what is opt-in.
 */
/** The shipped version, read at build time so the nav chip cannot go stale. */
const CORE_VERSION: string = JSON.parse(
    readFileSync(new URL('../../../../packages/core/package.json', import.meta.url), 'utf8'),
).version;

/**
 * The numbers this page quotes, MEASURED at build time.
 *
 * They were hardcoded first, which is the exact failure this repo keeps finding:
 * a line that describes the code has to be re-measured, not trusted. Everything
 * below is counted from the filesystem on every build, so the page cannot drift
 * from the repo — and anything that could only be counted approximately was
 * dropped rather than printed as if it were exact.
 */
const REPO = new URL('../../../../', import.meta.url);
const at = (p: string) => new URL(p, REPO);

/** Gate steps and how many of them are `check:*` guards. */
const gate: string = JSON.parse(readFileSync(at('package.json'), 'utf8')).scripts.gate;
const GATE_STEPS = gate.split('&&').length;
const GATE_GUARDS = gate.split('&&').filter((s) => /pnpm check/.test(s)).length;

/** Playwright spec files. */
const E2E_SPECS = readdirSync(at('e2e/tests')).filter((f) => f.endsWith('.spec.ts')).length;

/** Vitest files across every package (not individual `it()`s — that count can
 *  only be had by running the suite, and an approximation printed as a fact is
 *  the same rot in a different coat). */
function countTestFiles(dir: URL): number {
    let n = 0;
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
        if (entry.isDirectory()) {
            if (['node_modules', 'dist', '.svelte-kit', '.angular'].includes(entry.name)) continue;
            n += countTestFiles(new URL(`${entry.name}/`, dir));
        } else if (/\.(test|spec)\.ts$/.test(entry.name)) n++;
    }
    return n;
}
const TEST_FILES = countTestFiles(at('packages/'));

/**
 * How many tests actually RAN, stamped by `scripts/stamp-test-count.mjs` on every
 * `pnpm test`. Individual `it()`s cannot be counted statically here — several
 * suites are table-driven and a `grep` undercounts them badly — so this is the one
 * number that has to come from an execution.
 *
 * Absent (a fresh clone that has never run the suite), the page falls back to a
 * FLOOR rather than a guess: an inequality cannot go stale downward while the
 * suite only grows, which is the one honest thing to say without having measured.
 */
let TESTS_RAN: number | null = null;
let FILES_RAN: number | null = null;
try {
    const stamp = JSON.parse(readFileSync(at('apps/docs/src/data/test-counts.json'), 'utf8'));
    TESTS_RAN = stamp.tests ?? null;
    FILES_RAN = stamp.files ?? null;
} catch { /* never measured here — the fallbacks below are used instead */ }
const TESTS_LABEL = TESTS_RAN ? `${TESTS_RAN.toLocaleString('en-US')} tests, all green` : 'more than 1,000 tests';
/* The RUN is the authority on how many files there are: the walk above and vitest
   disagreed by three (121 against 118), because the workspace picks up test files
   the walk's exclusions miss. Prefer the measurement, keep the walk as the answer
   for a clone that has never run the suite. */
const FILES = FILES_RAN ?? TEST_FILES;

/** Published packages. */
function countPackages(dir: URL): number {
    let n = 0;
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
        if (!entry.isDirectory() || ['node_modules', 'dist'].includes(entry.name)) continue;
        const child = new URL(`${entry.name}/`, dir);
        const names = readdirSync(child);
        if (names.includes('package.json')) {
            const pkg = JSON.parse(readFileSync(new URL('package.json', child), 'utf8'));
            if (!pkg.private && pkg.name) n++;
        }
        n += countPackages(child);
    }
    return n;
}
const PACKAGES = countPackages(at('packages/'));

/** Keys in `AparteLocale` — i.e. how many strings a language is. Counted because
 *  adding ONE key made five hand-written "forty"s on this page wrong in the same
 *  commit that added it. */
const LOCALE_KEYS = (readFileSync(at('packages/core/src/config/locale.ts'), 'utf8')
    .match(/^\s+[a-zA-Z]+\??:\s*string/gm) ?? []).length;

/** Distinct `--aparte-*` custom properties declared in core's stylesheet. */
const CSS_VARS = new Set(
    (readFileSync(at('packages/core/src/styles/aparte.css'), 'utf8')
        .match(/^\s*--aparte-[a-z0-9-]+(?=\s*:)/gm) ?? []).map((s) => s.trim()),
).size;

/** The page already numbers its facts row in serif italic roman; the segment
 *  cards echo it, which is what makes ten boxes read as one enumeration. */
const ROMAN = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii', 'ix', 'x'];

/** The five demo tabs. `caption` is what the panel is showing; the source for
 *  each lives as a real <pre> in the markup, not a string built in JS. */
const DEMOS = [
    { key: 'chat', label: 'Chat' },
    { key: 'tools', label: 'Tools & approval' },
    { key: 'segments', label: 'Segments' },
    { key: 'artifact', label: 'Artifacts' },
    { key: 'branch', label: 'Branching' },
];

interface Kind { tag: string; body: string; states: string[] }

const KINDS: Kind[] = [
  { tag: 'text', body: 'Streamed token by token. Markdown and highlighting are plugins you opt into, so the core stays dependency-free.', states: [] },
  { tag: 'thinking', body: 'A collapsible block that closes itself the moment the model stops thinking — not when the answer ends.', states: [] },
  { tag: 'code', body: 'A fenced block with a copy button that copies the source, not the markup.', states: [] },
  { tag: 'tool_call', body: 'Five states, including a built-in Approve / Reject gate that pauses the turn.', states: ['pending', 'awaiting-approval', 'resolved', 'rejected', 'aborted'] },
  { tag: 'progress', body: 'A live bar for long work, so a slow step is visible instead of silent.', states: ['pending', 'running', 'complete', 'error'] },
  { tag: 'error', body: 'A failure card inside the turn that produced it — not a toast somewhere else on the page.', states: [] },
  { tag: 'artifact', body: 'Tabbed Code / Preview. The preview runs in a sandboxed iframe, and only ever after a person presses Preview.', states: [] },
  { tag: 'pipeline-waiting', body: 'The indicator for a multi-step turn, so the gap between two phases never reads as a hang.', states: [] },
];

const FAMILIES = [
  {
    name: 'Core', count: 'two packages', items: [
      { pkg: '@aparte/core', line: 'The web components, the renderers, the transports. Zero runtime dependencies.' },
      { pkg: '@aparte/engine', line: 'The agent loop on its own, drivable from your code. A test proves both loops behave identically.' },
    ],
  },
  {
    name: 'Frameworks', count: 'four wrappers, published', items: [
      { pkg: '@aparte/react', line: 'Component, hooks, a conversation-manager hook.' },
      { pkg: '@aparte/vue', line: 'Component, composables.' },
      { pkg: '@aparte/svelte', line: 'Component, stores.' },
      { pkg: '@aparte/angular', line: 'Standalone component, services, one-call provideAparte().' },
    ],
  },
  {
    name: 'Providers', count: 'three', items: [
      { pkg: '@aparte/provider-openai-compat', line: 'One zero-dependency adapter for the whole OpenAI-compatible family, with presets for OpenAI, Mistral, Z.AI, OpenRouter, LM Studio and Ollama.' },
      { pkg: '@aparte/provider-ai-sdk', line: 'A bridge to any Vercel AI SDK model — install that vendor’s own adapter and it runs under aparté’s loop.' },
      { pkg: '@aparte/provider-transformers', line: 'The model runs in the browser. WebGPU with a WASM fallback, in a worker, weights cached and evicted through the Cache API. No server, no key.' },
    ],
  },
  {
    name: 'Plugins', count: 'five', items: [
      { pkg: '@aparte/plugin-marked', line: 'Markdown, rendered once at the end of a message.' },
      { pkg: '@aparte/plugin-streaming-markdown', line: 'Markdown while it streams — and it strips a javascript: href mid-stream, not only at the final render.' },
      { pkg: '@aparte/plugin-shiki', line: 'Syntax highlighting, with a second entry point for consumers who want to control what their bundler emits.' },
      { pkg: '@aparte/plugin-model-selector', line: 'A real ARIA combobox, grouped by provider, keyboard-operable.' },
      { pkg: '@aparte/plugin-ask-user', line: 'The ask_user tool: the model asks a structured question, the answer stays in the transcript.' },
    ],
  },
  {
    name: 'Locales', count: `one shipped — and any language is ${LOCALE_KEYS} strings`, items: [
      { pkg: '@aparte/locale-fr', line: 'French, complete. Hand it to setLocale() at runtime; resetLocale() goes back to English.' },
      { pkg: 'setLocale({ … })', line: `Your own language needs no package, no build step and no PR here: a locale is a plain object of ${LOCALE_KEYS} strings, and English ships inside core as the default.` },
    ],
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{LANDING_TITLE}</title>
    <meta name="description" content={LANDING_DESCRIPTION} />
    <link rel="canonical" href="https://apartejs.dev/" />

    <!-- This page is an Astro page, not a Starlight one, so it inherits none of the head
         Starlight builds: it had NO Open Graph at all, while being the most-shared URL of
         the site. Every link to it rendered as a bare line of text in Slack, Discord,
         LinkedIn and X. The card itself is generated at build time like every docs page's
         (src/pages/og/), so this stays a list of pointers, not a second design. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aparté" />
    <meta property="og:title" content={LANDING_TITLE} />
    <meta property="og:description" content={LANDING_DESCRIPTION} />
    <meta property="og:url" content="https://apartejs.dev/" />
    <meta property="og:image" content="https://apartejs.dev/og/index.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={LANDING_IMAGE_ALT} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={LANDING_TITLE} />
    <meta name="twitter:description" content={LANDING_DESCRIPTION} />
    <meta name="twitter:image" content="https://apartejs.dev/og/index.png" />
    <meta name="twitter:image:alt" content={LANDING_IMAGE_ALT} />

    <!-- What the software IS, said in a vocabulary a machine can read rather than
         inferred from marketing prose. `SoftwareSourceCode` is the type for a
         library one reads and depends on; the runnable product it targets is nested
         rather than flattened, because `applicationCategory` and `softwareVersion`
         belong to `SoftwareApplication` and mixing the two vocabularies on one node
         is invalid. Description and version come from the same places the tags
         above do, so this cannot become a fifth copy that drifts. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: 'aparté',
      description: LANDING_DESCRIPTION,
      url: 'https://apartejs.dev/',
      codeRepository: 'https://github.com/apartejs/aparte',
      license: 'https://opensource.org/licenses/MIT',
      programmingLanguage: 'TypeScript',
      targetProduct: {
        '@type': 'SoftwareApplication',
        name: '@aparte/core',
        applicationCategory: 'DeveloperApplication',
        softwareVersion: CORE_VERSION,
        operatingSystem: 'Any',
      },
    })} />
    <!-- This page is `/`, which is where a crawler looks for the site's icon — so the
         links live here too, not only in the Starlight config (that one covers the
         docs pages). SVG for browsers, .ico as the raster search engines prefer. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script is:inline>
      // Shared light/dark with the Starlight docs: read the SAME localStorage key
      // Starlight uses (`starlight-theme`) and apply `data-theme` before paint, so
      // the choice made on the docs carries over to the landing with no flash.
      (() => {
        const stored = localStorage.getItem('starlight-theme') || 'auto';
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="stage-glow" aria-hidden="true"></div>

    <main class="wrap">
      <nav>
        <div class="brand serif"><span class="paren">(</span>&#8202;apart&eacute;&#8202;<span class="paren">)</span></div>
        <div class="nav-links">
          <a class="ver" href="/changelog/" title="What changed in each release">
            <b>v{CORE_VERSION}</b><span class="alpha">alpha</span>
          </a>
          <a href="/why/" class="hide-sm">Why apart&eacute;</a>
          <a href="/guides/getting-started/" class="hide-sm">Docs</a>
          <a href="https://github.com/apartejs/aparte" target="_blank" rel="noopener">GitHub</a>
          <button class="toggle" id="themeToggle" aria-label="Switch theme" title="Switch theme">&#9789;</button>
        </div>
      </nav>

      <section class="hero">
       <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">AI chat in Web Components &mdash; <b>with the agent loop inside</b></p>
          <h1 class="thesis serif">Chat, spoken <em>aside.</em></h1>
          <p class="lede">
            Not a bubble kit. One element gives you the whole turn: <b>ten kinds of content</b>,
            a tool loop that <b>pauses for a human&#8217;s approval</b>, branch-and-retry on any
            reply &#8212; with <b>zero runtime dependencies</b>. React, Vue, Svelte, Angular, or
            nothing at all.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/guides/getting-started/">Read the docs &#8594;</a>
            <a class="btn btn-ghost" href="https://github.com/apartejs/aparte" target="_blank" rel="noopener">Star on GitHub</a>
          </div>
          <div class="install">
            <pre class="mono"><span class="prompt">$</span> npm i @aparte/core</pre>
            <button class="install-copy" id="copyInstall" type="button" aria-label="Copy install command" title="Copy"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
          </div>
          <p class="reassure">
            Drop <code>&lt;aparte-chat&gt;</code> into any web app, point it at a model, and the
            defaults are a working chat. Customize only what you need.
          </p>
        </div>

        <!-- The thesis, in the shape it actually has. This column held the chat
             before the chat got its own section; a code card states the same
             claim as the lede without repeating any section below it. -->
        <div class="hero-aside">
          <div class="code mono" aria-label="The shape of one assistant reply">
<pre><span class="cm">// an assistant reply is not a string</span>
message.segments = [
  &#123; type: <span class="st">'thinking'</span>,  &#8230; &#125;,
  &#123; type: <span class="st">'tool_call'</span>,
    status: <span class="tg">'awaiting-approval'</span> &#125;,
  &#123; type: <span class="st">'code'</span>,      &#8230; &#125;,
  &#123; type: <span class="st">'text'</span>,      &#8230; &#125;,
]</pre>
          </div>
        </div>
       </div>

        <div class="facts">
          <span><span class="k">i.</span><b>Zero</b> runtime dependencies</span>
          <span><span class="k">ii.</span><b>{KINDS.length}</b> kinds of content in one turn</span>
          <span><span class="k">iii.</span><b>{CSS_VARS}</b> CSS variables, no shadow DOM</span>
          <span><span class="k">iv.</span>Your key, your server &#8212; <b>or no server at all</b></span>
        </div>
      </section>

      <!-- The real @aparte/core, given the whole width and five things to show.
           It sat in a 380px column beside the hero copy, where a reasoning block
           and a tool call could not both be on screen — which is the one thing
           this page needs to show. The source sits beside each panel because that
           answers the second question a developer has ("what do I write") on the
           same pixels as the first. -->
      <!-- The measured counts ride on the element: this page's client script is a
           bundled module, so it cannot read the frontmatter, and hardcoding the
           numbers a second time is how two copies of one fact start disagreeing. -->
      <section class="stage" id="demo" data-kinds={KINDS.length} data-vars={CSS_VARS} data-locale={LOCALE_KEYS}>
        <div class="demo-tabs" role="tablist" aria-label="What the chat can do" id="demoTabs">
          {DEMOS.map((d, i) => (
            <button class="tab" role="tab" type="button" data-demo={d.key} aria-selected={i === 0 ? 'true' : 'false'}>{d.label}</button>
          ))}
        </div>
        <p class="demo-cap" id="demoCap"></p>

        <div class="demo-split">
          <div class="aside-stage">
            <div class="gutter" aria-hidden="true">
              <span class="rule"></span>
              <span class="tag">apart&eacute;</span>
              <span class="rule"></span>
            </div>
            <div class="chat" aria-label="Live aparte chat — the real component, running in this page.">
              <div class="chat-head">
                <span class="dot"></span> assistant &middot; running here, in this page
                <span class="hint" id="demoHint"></span>
              </div>
              <div class="aparte-demo">
                <!-- No `placeholder` attribute on purpose. An attribute WINS over the locale
                     (attribute -> composer property -> `t('inputPlaceholder')`), which is right —
                     the app owns its own copy — but it also meant the Language lever could not
                     move the one string a visitor is looking straight at. Letting the locale
                     drive it costs a branded sentence and buys an honest demo. -->
                <aparte-chat attachments center-empty></aparte-chat>
              </div>
            </div>
          </div>

          <div class="demo-code">
            <div class="code-head">
              source
              <span class="frameworks">
                only the two lines that mount it differ &#8212; everything here is the same in
                React, Vue, Svelte and Angular. <a href="#mount">See the mount &#8594;</a>
              </span>
            </div>
            <div class="code mono">
<pre class="pane is-on" data-pane="chat"><span class="cm">// the whole chat, plus the files the composer collects</span>
<span class="kw">import</span> <span class="st">'@aparte/core'</span>;
<span class="kw">import</span> <span class="st">'@aparte/core/styles.css'</span>;

<span class="tg">&lt;aparte-chat attachments center-empty&gt;&lt;/aparte-chat&gt;</span>

composer.<span class="fn">addEventListener</span>(<span class="st">'aparte-send'</span>, (e) =&gt; &#123;
  <span class="kw">const</span> &#123; content, files &#125; = e.detail;
  viewport.<span class="fn">appendMessage</span>(&#123; id, role: <span class="st">'user'</span>, content &#125;);
  <span class="cm">// …then stream your model's reply back in</span>
  viewport.<span class="fn">appendToken</span>(id, chunk);
  viewport.<span class="fn">completeMessage</span>(id);
&#125;);</pre>
<pre class="pane" data-pane="tools"><span class="cm">// a tool that stops the turn until a person decides</span>
aparteGlobalConfig.<span class="fn">registerTool</span>(&#123;
  name: <span class="st">'delete_file'</span>,
  description: <span class="st">'Delete a file from the project'</span>,
  inputSchema: &#123; <span class="cm">/* JSON Schema */</span> &#125;,
  <span class="kw">needsApproval</span>: <span class="tg">true</span>,
&#125;, <span class="kw">async</span> (&#123; path &#125;) =&gt; remove(path));

<span class="cm">// core renders Approve / Reject and dispatches this.</span>
<span class="cm">// AparteClient answers it for you; this page answers</span>
<span class="cm">// it itself, which is all a host has to do.</span>
chat.<span class="fn">addEventListener</span>(<span class="st">'aparte-tool-decision'</span>, (e) =&gt; &#123;
  <span class="kw">const</span> &#123; toolCallId, approved &#125; = e.detail;
&#125;);</pre>
<pre class="pane" data-pane="segments"><span class="cm">// two kinds in one reply — and no streaming needed:</span>
<span class="cm">// a settled segment renders as it is</span>
viewport.<span class="fn">appendMessage</span>(&#123; id, role: <span class="st">'assistant'</span> &#125;);

viewport.<span class="fn">addSegment</span>(id, &#123; id: <span class="st">'s1'</span>, type: <span class="st">'thinking'</span>,
  content: <span class="st">'…'</span>, isStreaming: <span class="tg">false</span> &#125;);
viewport.<span class="fn">addSegment</span>(id, &#123; id: <span class="st">'s2'</span>, type: <span class="st">'code'</span>,
  language: <span class="st">'ts'</span>, content: <span class="st">'…'</span>, isStreaming: <span class="tg">false</span> &#125;);
<span class="cm">// You never write messageId, index, startedAt or endedAt:</span>
<span class="cm">// the owner stamps them on the way in. Read the span back</span>
<span class="cm">// with segmentDuration(s) — it is live while it streams.</span></pre>
<pre class="pane" data-pane="artifact"><span class="cm">// the model wrote a document; core renders the card</span>
viewport.<span class="fn">addSegment</span>(mid, &#123;
  id: <span class="st">'a1'</span>, type: <span class="st">'artifact'</span>,
  artifactType: <span class="st">'svg'</span>,
  mimeType: <span class="st">'image/svg+xml'</span>,
  title: <span class="st">'Turn latency by segment'</span>,
  content: svgTheModelWrote,
&#125;);

<span class="cm">// The Preview tab mounts a sandboxed iframe —</span>
<span class="cm">// sandbox="allow-scripts", a CSP delivered twice, and</span>
<span class="cm">// ONLY on a human press. Reloading a saved thread</span>
<span class="cm">// never re-runs what a model wrote.</span></pre>
<pre class="pane" data-pane="branch"><span class="cm">// only `copy` is on by default — a button nobody</span>
<span class="cm">// answers is a lie told to the user</span>
aparteGlobalConfig.<span class="fn">setBubbleActions</span>(&#123; retry: <span class="tg">true</span> &#125;);

<span class="cm">// retry forks a sibling instead of overwriting,</span>
<span class="cm">// and the ‹1/2› picker appears on its own</span>
document.<span class="fn">addEventListener</span>(<span class="st">'aparte-retry'</span>, (e) =&gt; &#123;
  <span class="kw">const</span> id = viewport.<span class="fn">addSiblingOf</span>(e.detail.messageId, &#123;
    id: next, role: <span class="st">'assistant'</span>, content: <span class="st">''</span>,
  &#125;);
  <span class="cm">// …then stream the new version into `id`</span>
&#125;);</pre>
            </div>
          </div>
        </div>
        <!-- The levers, BELOW the demo and on ONE line. They were above it, and as
             three stacked rows of pills, which is a slab of chrome between the
             visitor and the thing they came for however it is styled. Selects say
             "settings" in one row and one glance.

             They apply to EVERY panel and they SURVIVE a tab switch — the point of a
             live lever is watching your own palette land on the approval gate and
             the artifact card. Three seams, deliberately separate: the palette is
             CSS variables, the icons are a provider object, the language is a plain
             object of strings. Any one without the others.

             They replace a "Themes & icons" TAB, which existed to mix a palette and
             an icon set — a thing the page now does at all times, on every panel.
             A tab for it was a tab for the controls beside it. -->
        <div class="levers">
          <label>Palette
            <select id="lvPalette">
              <option value="stage" selected>Stage &mdash; follows this page</option>
              <option value="violet">Violet &mdash; pinned dark</option>
              <option value="paper">Paper &mdash; pinned light</option>
            </select>
          </label>
          <label>Icons
            <select id="lvIcons">
              <option value="default" selected>Default &mdash; what core ships</option>
              <option value="solid">Solid</option>
              <option value="hard">Hard-edged</option>
            </select>
          </label>
          <label>Language
            <select id="lvLocale">
              <option value="en" selected>English</option>
              <option value="fr">Fran&ccedil;ais</option>
            </select>
          </label>
        </div>
      </section>

      <section class="band" id="turn">
        <div class="sec-head">
          <h2 class="serif">What a turn <span class="paren">(</span>contains<span class="paren">)</span></h2>
        </div>
        <p class="sec-sub">
          A reply is not a string &#8212; it is a structured turn. A list of <b>segments</b>, and {KINDS.length} kinds ship
          registered by default &#8212; mixable in a single message, each with its own renderer you
          can replace. This is the unit a presentational component kit has no way to express.
        </p>
        <div class="kinds">
          {KINDS.map((k, i) => (
            <div class="kind">
              <span class="idx" aria-hidden="true">{ROMAN[i]}</span>
              <h3><code>{k.tag}</code></h3>
              <p>{k.body}</p>
              {k.states.length > 0 && (
                <div class="states">{k.states.map((s) => <span>{s}</span>)}</div>
              )}
            </div>
          ))}
        </div>
        <p class="sec-note">
          Every segment also knows where it is &#8212; its message, its index, and a span that
          advances while it streams and freezes when it settles, so &#8220;Thought for 1.4s&#8221;
          is data you read rather than a timer you keep. Core stamps it and renders none of it.
          <a href="/guides/customization/">Register your own kind &#8594;</a>
        </p>
      </section>

      <section class="band" id="human">
        <div class="sec-head">
          <h2 class="serif">A human, <span class="paren">(</span>in the loop<span class="paren">)</span></h2>
        </div>
        <p class="sec-sub">
          The part that makes this a library and not a widget: the turn can <b>stop and wait for
          a person</b>, and core draws that pause itself.
        </p>
        <div class="split">
          <div class="prose">
            <ul>
              <li>Mark a tool <b>needsApproval</b> and the loop pauses before the handler runs. Core renders Approve and Reject inline and dispatches a decision event; on reject a &#8220;rejected by user&#8221; result is injected and the turn stops.</li>
              <li><b>Ten tool round-trips</b> per turn by default, overridable per run and per tool.</li>
              <li>A turn can also <b>ask a structured question</b> &#8212; a schema-driven panel in the composer, and the question with its answer stays in the transcript afterwards.</li>
              <li><b>Abort</b> is checked on both sides of every stream read, and each tool call can race its own timeout.</li>
            </ul>
          </div>
          <div class="code mono">
<pre><span class="cm">// the turn pauses here until someone presses Approve</span>
aparteGlobalConfig.<span class="fn">registerTool</span>(
  &#123;
    name: <span class="st">'delete_file'</span>,
    description: <span class="st">'Delete a file from the project'</span>,
    inputSchema: &#123; <span class="cm">/* JSON Schema */</span> &#125;,
    <span class="kw">needsApproval</span>: <span class="tg">true</span>,
  &#125;,
  <span class="kw">async</span> (&#123; path &#125;) =&gt; remove(path),
);</pre>
          </div>
        </div>
      </section>

      <section class="band" id="branch">
        <div class="sec-head">
          <h2 class="serif">Branch <span class="paren">(</span>any turn<span class="paren">)</span></h2>
        </div>
        <p class="sec-sub">
          Retry does not overwrite an answer. It <b>forks a sibling</b>, and a picker appears so a
          reader can move between versions &#8212; the same behaviour every serious chat product has,
          built in rather than rebuilt.
        </p>
        <div class="split">
          <div class="prose">
            <p>
              Try it on the chat above: send a message, hover the reply, press retry. The two
              versions stay side by side behind the counter, and nothing is lost.
            </p>
            <p>
              Bubble actions are <b>off until you handle them</b>, which is the rule the whole
              library follows: a button nobody answers is a lie told to the user. Copy works with
              core alone, so copy is the only one on by default.
            </p>
          </div>
          <div class="code mono">
<pre><span class="cm">// retry is honoured by whoever runs the loop —</span>
<span class="cm">// AparteClient, or this page's own listener</span>
aparteGlobalConfig.<span class="fn">setBubbleActions</span>(&#123; retry: <span class="tg">true</span> &#125;);

<span class="cm">// and a fork is one call on the viewport</span>
viewport.<span class="fn">addSiblingOf</span>(messageId, next);</pre>
          </div>
        </div>
      </section>

      <section class="band" id="style">
        <div class="sec-head">
          <h2 class="serif">Make it <span class="paren">(</span>yours<span class="paren">)</span></h2>
        </div>
        <p class="sec-sub">
          <b>{CSS_VARS} custom properties</b>, and <b>no shadow DOM anywhere</b> in core &#8212; so
          there is no boundary to pierce. A plain selector reaches any node, and devtools shows you
          the real one. Four levers, in order of how far they go:
        </p>
        <div class="split">
          <div class="prose">
            <ul>
              <li><b>Variables.</b> Colours, spacing, radii, font sizes, border widths &#8212; and one master, <code>--aparte-primary</code>, that ninety-five of them derive from. Set it on <code>:root</code> and the whole palette follows.</li>
              <li><b>Icons.</b> An icon provider, not a hardcoded set: <code>setIconProvider()</code> takes yours and re-renders what is already on screen, so a set can be swapped live.</li>
              <li><b>Language.</b> A locale is a plain object of {LOCALE_KEYS} strings handed to <code>setLocale()</code>. Your own language needs no package and no pull request here.</li>
              <li><b>Renderers.</b> When a variable is not enough &#8212; a reasoning block you want as one line rather than an accordion &#8212; replace the renderer. Structure is not hostage to a stylesheet.</li>
            </ul>
          </div>
          <div class="code mono">
<pre><span class="cm">/* one instance, three variables */</span>
<span class="tg">aparte-chat</span> &#123;
  <span class="kw">--aparte-accent</span>: <span class="st">#c9a227</span>;
  <span class="kw">--aparte-bg</span>: <span class="st">#14101c</span>;
  <span class="kw">--aparte-avatar-radius</span>: <span class="st">6px</span>;
&#125;

<span class="cm">/* light DOM: an ordinary selector, no ::part() */</span>
<span class="tg">.segment-tool-call .tool-pill</span> &#123;
  <span class="kw">font-variant</span>: <span class="st">small-caps</span>;
&#125;</pre>
          </div>
        </div>
        <p class="sec-note">
          <a href="/reference/css-variables/">Every variable, listed &#8594;</a>
        </p>
      </section>

      <section class="band" id="mount">
        <div class="sec-head">
          <h2 class="serif">Five ways to <span class="paren">(</span>mount it<span class="paren">)</span></h2>
        </div>
        <p class="sec-sub">
          It is one web component underneath, so the rendered chat is identical everywhere. What
          changes is the two lines you write.
        </p>
        <div class="tabs" role="tablist" id="tabs">
          <button class="tab" role="tab" aria-selected="true" data-fw="vanilla">Vanilla</button>
          <button class="tab" role="tab" aria-selected="false" data-fw="react">React</button>
          <button class="tab" role="tab" aria-selected="false" data-fw="vue">Vue</button>
          <button class="tab" role="tab" aria-selected="false" data-fw="svelte">Svelte</button>
          <button class="tab" role="tab" aria-selected="false" data-fw="angular">Angular</button>
        </div>
        <div class="code tabbed mono"><pre id="snippet"></pre></div>
        <p class="sec-note">
          All four wrappers are published today, and the same browser suite drives them next to
          the vanilla build. Core also ships a Node entry point, so importing types on a server
          does not need a DOM.
        </p>
      </section>

      <section class="band" id="plug">
        <div class="sec-head">
          <h2 class="serif">What you <span class="paren">(</span>plug in<span class="paren">)</span></h2>
        </div>
        <p class="sec-sub">
          {PACKAGES} packages, {FAMILIES.length} families. Everything past the core is something
          you choose &#8212; nothing arrives because it might be useful.
        </p>
        <div class="families">
          {FAMILIES.map((f) => (
            <div class="family">
              <h3>{f.name}</h3>
              <span class="count">{f.count}</span>
              <ul>
                {f.items.map((i) => (
                  <li><code>{i.pkg}</code><em>{i.line}</em></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="band" id="proof">
        <div class="sec-head">
          <h2 class="serif">And it is <span class="paren">(</span>checked<span class="paren">)</span></h2>
        </div>
        <p class="sec-sub">
          An alpha, said plainly &#8212; the API can still change before 1.0. What does not change
          is how it is verified.
        </p>
        <div class="proof">
          <div><strong>{FILES}</strong><span>test files, over all {PACKAGES} published packages<em>{TESTS_LABEL}</em></span></div>
          <div><strong>{E2E_SPECS}</strong><span>Playwright specs in real Chromium, WebKit and Firefox</span></div>
          <div><strong>{GATE_STEPS}</strong><span>gate steps, {GATE_GUARDS} of them guards &#8212; one checks the CI runs the rest</span></div>
          <div><strong>axe</strong><span>accessibility scans on an idle chat, a stream, an open dropdown, a failure</span></div>
        </div>
        <p class="sec-note">
          The API reference on this site is generated from the components themselves at build
          time, so it cannot drift from the code.
          <a href="/reference/api/">Read the reference &#8594;</a>
        </p>
      </section>

      <footer>
        <div class="brand serif"><span class="paren">(</span>&#8202;apart&eacute;&#8202;<span class="paren">)</span></div>
        <div class="foot-links">
