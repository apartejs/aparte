    </main>

    <script>
      // The real library — registers <aparte-*> elements + pulls in the theme.
      import '@aparte/core';
      import '@aparte/core/styles.css';
      import { registerDefaultRenderers, aparteGlobalConfig } from '@aparte/core';
      // The real package, not a French object typed into this page: a lever that
      // demonstrates localisation has to be the thing a consumer would install.
      import { fr } from '@aparte/locale-fr';
      registerDefaultRenderers();
      // `retry` IS turned on here, and copy stays on as it is by default. The rule is
      // that a bubble action must be honoured by someone: copy is honoured by core
      // alone, and retry is honoured by the `aparte-retry` listener at the bottom of
      // this file, which forks a real branch. (It was left off while that listener
      // already existed, so the branching this page talks about could not be tried.)
      // edit/feedback/info stay off: nothing here would answer them.
      aparteGlobalConfig.setBubbleActions({ retry: true });

      // ── theme toggle — shared with the docs via the `starlight-theme` key ──
      // The inline <head> script already applied the persisted theme; here we
      // mirror it onto the chat component and persist any toggle to the SAME key
      // Starlight reads, so light/dark stays in sync across landing ↔ docs.
      const root = document.documentElement;
      const currentTheme = () =>
        root.getAttribute('data-theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      function applyTheme(theme: string) {
        root.setAttribute('data-theme', theme);
        // The CHAT's palette is not set here: a theme preset may pin it light or
        // dark independently of the page, so `applySkin` owns that attribute and
        // is re-run below once it exists.
      }
      applyTheme(currentTheme());
      document.getElementById('themeToggle')?.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        localStorage.setItem('starlight-theme', next);
        applyTheme(next);
        applySkin(skin);   // a "follow the page" preset has to follow it
      });

      // ── copy install command (icon copy → check) ──
      const copyBtn = document.getElementById('copyInstall');
      copyBtn?.addEventListener('click', () => {
        navigator.clipboard?.writeText('npm i @aparte/core');
        const original = copyBtn.innerHTML;
        copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(() => { copyBtn.innerHTML = original; }, 1400);
      });

      // ── the real chat: <aparte-chat center-empty> owns the empty→active slide ──
      const viewport = document.querySelector('aparte-chat-viewport') as any;
      const chatHost = document.querySelector('aparte-chat') as HTMLElement | null;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let msgId = 0;

      // Every panel below is a chain of timers. Switching tabs has to be able to
      // STOP the chain that was running, or two scripted demos write into the same
      // transcript and the result is nonsense that looks like a bug in the library.
      // `after` has setTimeout's argument order on purpose — it is a drop-in — and
      // it drops its callback if the run it belongs to is no longer the current one.
      let timers: number[] = [];
      let run = 0;
      const after = (fn: () => void, ms: number) => {
        const mine = run;
        timers.push(window.setTimeout(() => { if (mine === run) fn(); }, ms));
      };
      /** A tool call waiting for this page to answer, if any. */
      let pending: { mid: string; sid: string } | null = null;
      /** One scripted reply at a time, whichever panel asked for it. */
      let busy = false;
      function resetDemo() {
        run++;
        timers.forEach((t) => clearTimeout(t));
        timers = [];
        pending = null;
        busy = false;
        viewport?.setMessages([]);
      }

      /** Stream into ONE segment of a message (the panels that build segments). */
      function streamSegment(mid: string, sid: string, text: string, done?: () => void) {
        const toks = reduce ? [text] : text.split(/(\s+)/);
        let i = 0;
        const tick = () => {
          if (i < toks.length) { viewport.appendToSegment(mid, sid, toks[i++]); after(tick, reduce ? 200 : 26 + Math.random() * 40); }
          else { viewport.updateSegment(mid, sid, { isStreaming: false }); done?.(); }
        };
        after(tick, 200);
      }

      // Stream text into an EXISTING assistant message (fresh replies and retry
      // branches share this).
      function streamInto(id: string, text: string, done?: () => void) {
        // Reduced motion means "stop moving things", NOT "stop showing progress":
        // dumping the whole reply at once removed the two things this page exists to
        // demonstrate — the waiting state and the streaming — for every visitor with
        // the setting on. So keep both, minus the motion: the same opening pause (so
        // the built-in waiting indicator is seen; core already freezes its dots via
        // its own reduced-motion rule), then three steady chunks instead of ~40
        // jittered tokens.
        if (reduce) {
          const cuts = [Math.floor(text.length / 3), Math.floor((text.length * 2) / 3), text.length];
          let c = 0, from = 0;
          const step = () => {
            if (c < cuts.length) {
              viewport.appendToken(id, text.slice(from, cuts[c]));
              from = cuts[c++];
              after(step, 180);
            } else { viewport.completeMessage(id); done?.(); }
          };
          after(step, 320);
          return;
        }
        const toks = text.split(/(\s+)/); let i = 0;
        const tick = () => {
          if (i < toks.length) { viewport.appendToken(id, toks[i++]); after(tick, 30 + Math.random() * 48); }
          else { viewport.completeMessage(id); done?.(); }
        };
        after(tick, 220);
      }
      function streamAssistant(text: string, done?: () => void) {
        const id = 'a' + ++msgId;
        viewport.appendMessage({ id, role: 'assistant', content: '', timestamp: Date.now() });
        streamInto(id, text, done);
      }
      function replyTo(q: string) {
        q = q.toLowerCase();
        if (/approv|human|tool|loop|agent/.test(q))
          return 'A tool marked needsApproval pauses the turn before its handler runs — core draws Approve and Reject itself, and the loop resumes or injects a rejection. Up to ten tool round-trips per turn by default.';
        if (/frame|react|vue|svelte|angular|vanilla/.test(q))
          return 'React, Vue, Svelte, Angular — or none at all. It’s one web component underneath, so the chat renders identically everywhere; only the two lines that mount it change.';
        if (/style|css|theme|token|variable/.test(q))
          return `There are ${N_VARS} CSS variables, and no shadow DOM anywhere in core — so no ::part(), no piercing. Icons are a provider you can swap live, a language is ${N_LOCALE} strings in an object, and when none of that is enough the renderer itself is replaceable.`;
        if (/stream|token|type|render|reply/.test(q))
          return 'Exactly like this — token by token. aparte streams your model’s replies through a transport, and your API key can stay on your server.';
        if (/depend|size|zero|bundle|weight/.test(q))
          return 'Zero runtime dependencies in the core. Markdown, syntax highlighting and icons are opt-in plugins you add only if you want them.';
        if (/browser|local|offline|server|privacy/.test(q))
          return 'With @aparte/provider-transformers the model runs in the browser itself — WebGPU with a WASM fallback, in a worker, weights cached locally. No server, no key. Or point a transport at your own /api/chat and the key never leaves it.';
        if (/branch|retry|fork|version/.test(q))
          return 'Hover this reply and press retry: it forks a sibling instead of overwriting, and a picker appears so you can move between the two versions.';
        if (/what|who|aparte|hello|hi|hey/.test(q))
          return 'aparte is an AI-chat library in vanilla web components, zero dependencies — with the agent loop inside: tools, human approval, branching. This chat you’re using is the component itself, running right here.';
        return 'In the real thing I’d relay that to your model. Here I’m a small scripted stand-in, so you can feel the interaction — the streaming, the bubbles, the composer, and retry forking a branch.';
      }
      function send(text: string, files: File[] = []) {
        text = (text || '').trim();
        if ((!text && !files.length) || busy) return;
        busy = true;
        viewport.appendMessage({ id: 'u' + ++msgId, role: 'user', content: text, timestamp: Date.now() });
        // `attachments` is opt-in precisely because the HOST has to consume the
        // files (the attribute's own JSDoc says so). This page is the host, so it
        // says what it received instead of dropping them silently.
        const reply = files.length
          ? `I received ${files.length} file${files.length > 1 ? 's' : ''} — ${files.map((f) => f.name).join(', ')}. `
            + 'A real host would forward them to the model; the composer collected them for you either way.'
          : replyTo(text);
        after(() => streamAssistant(reply, () => { busy = false; }), 240);
      }
      document.querySelector('aparte-composer')?.addEventListener('aparte-send', (e) => {
        const detail = (e as any).detail || {};
        send(detail.content || '', Array.from(detail.files || []));
      });
      // Retry forks a BRANCH instead of appending: addSiblingOf() creates a new
      // sibling of the retried answer, and the built-in ‹1/2› picker appears so
      // you can flip between versions — what a real app gets from AparteClient.
      document.addEventListener('aparte-retry', (e) => {
        if (busy) return;
        const messageId = (e as any).detail?.messageId;
        const id = viewport.addSiblingOf(messageId, { id: 'a' + ++msgId, role: 'assistant', content: '', timestamp: Date.now() });
        if (!id) return;
        busy = true;
        streamInto(id, 'Here’s another take — retry forked a new branch instead of overwriting. Use the ‹1/2› picker above to compare versions.', () => { busy = false; });
      });
      // ── the five panels ───────────────────────────────────────────────────
      // Segments are always created with `addSegment`, never by seeding a
      // `segments: [...]` array on appendMessage(). That shortcut looks equivalent
      // and is not: streaming into a seeded segment with appendToSegment() DOUBLES
      // its content in the model — measured, "ThatThat  deletesdeletes  aa  filefile"
      // — because the bubble and the repository end up advancing the same object.
      // `addSegment` gives each view a value it owns.

      function demoChat() {
        // Opens on the empty state; the greeting after a beat trips the shell's
        // empty→active slide on its own (the first bubble clears center-empty).
        after(() => streamAssistant('Hi — I’m aparté, streaming this to you token by token. Attach a file, or ask about tool approval, branching or styling.'), 800);
      }

      function demoTools() {
        viewport.appendMessage({ id: 'u' + ++msgId, role: 'user', content: 'src/legacy.ts is dead code — remove it.', timestamp: Date.now() });
        const mid = 'a' + ++msgId;
        after(() => {
          viewport.appendMessage({ id: mid, role: 'assistant', content: '', timestamp: Date.now() });
          viewport.addSegment(mid, { id: 'tl-say', type: 'text', content: '', isStreaming: true });
          streamSegment(mid, 'tl-say', 'That deletes a file, so I’ll ask before I run it.', () => {
            after(() => {
              viewport.addSegment(mid, {
                id: 'tl-call', type: 'tool_call', status: 'awaiting-approval',
                toolCall: { id: 'tc-1', name: 'delete_file', input: { path: 'src/legacy.ts' } },
              });
              pending = { mid, sid: 'tl-call' };
            }, 260);
          });
        }, 420);
      }

      function demoSegments() {
        viewport.appendMessage({ id: 'u' + ++msgId, role: 'user', content: 'What can one reply actually contain?', timestamp: Date.now() });
        const mid = 'a' + ++msgId;
        after(() => {
          viewport.appendMessage({ id: mid, role: 'assistant', content: '', timestamp: Date.now() });
          viewport.addSegment(mid, {
            id: 'sg-think', type: 'thinking', isStreaming: false, collapsed: false,
            content: 'Two kinds in one reply — this reasoning block and a code fence. Neither of them is a chat bubble.',
          });
          after(() => viewport.addSegment(mid, {
            id: 'sg-code', type: 'code', language: 'ts', filename: 'segments.ts', isStreaming: false,
            content: 'export function isSegmentSettled(s: AparteSegment) {\n'
              + '  return s.type === \'tool_call\'\n'
              + '    ? s.status !== \'pending\'\n'
              + '    : s.isStreaming === false;\n}',
          }), 750);
          after(() => viewport.completeMessage(mid), 2350);
        }, 420);
      }

      function demoArtifact() {
        viewport.appendMessage({ id: 'u' + ++msgId, role: 'user', content: 'Chart the latency of each segment in that turn.', timestamp: Date.now() });
        const mid = 'a' + ++msgId;
        after(() => {
          viewport.appendMessage({ id: mid, role: 'assistant', content: '', timestamp: Date.now() });
          viewport.addSegment(mid, { id: 'ar-say', type: 'text', content: '', isStreaming: true });
          streamSegment(mid, 'ar-say', 'Here it is. Press Preview to run it — nothing executes until you do.', () => {
            after(() => {
              viewport.addSegment(mid, {
                id: 'ar-doc', type: 'artifact', isStreaming: false,
                artifactType: 'svg', mimeType: 'image/svg+xml',
                title: 'Turn latency by segment',
                // An SVG rather than React on purpose: core previews html/svg/js/css
                // with its own CDN-free fallback, so this needs no host builder —
                // what you see is the library, not this page's scaffolding.
                content: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 150" width="320" height="150">
  <rect width="320" height="150" fill="#14101c"/>
  <g font-family="Georgia, serif" font-size="9" fill="#a89bb6">
    <text x="12" y="26">thinking</text><text x="12" y="56">tool_call</text>
    <text x="12" y="86">code</text><text x="12" y="116">text</text>
  </g>
  <g fill="#c9a227">
    <rect x="70" y="16" width="58" height="12" rx="2"/>
    <rect x="70" y="46" width="164" height="12" rx="2"/>
    <rect x="70" y="76" width="41" height="12" rx="2"/>
    <rect x="70" y="106" width="96" height="12" rx="2"/>
  </g>
  <g font-family="ui-monospace, monospace" font-size="8" fill="#6f6480">
    <text x="134" y="26">1.4s</text><text x="240" y="56">4.1s</text>
    <text x="117" y="86">0.9s</text><text x="172" y="116">2.3s</text>
  </g>
</svg>`,
              });
              viewport.completeMessage(mid);
            }, 300);
          });
        }, 420);
      }

      function demoBranch() {
        after(() => streamAssistant('Hover this reply and press retry. It forks a sibling instead of overwriting, and a ‹1/2› picker appears so you can move between the two versions — nothing is lost.'), 700);
      }

      // ── theme presets ─────────────────────────────────────────────────────
      // The FIRST version of this hand-picked four variables and produced light
      // bubbles with light text on them, because the text is painted through
      // `--aparte-text` which it never touched. The mechanism core actually ships
      // is an attribute: `:root` IS the light palette and `[data-aparte-theme="dark"]`
      // is the override — so "light" is the ABSENCE of the attribute, not a list of
      // colours. Each preset therefore picks a base with the attribute and then
      // spends a handful of variables on top of a palette that is already coherent.
      // Icons are a PROVIDER of `() => string`, every key optional with a built-in
      // fallback — so a preset can ship three and inherit the rest, and switching
      // one re-renders what is already on screen. Showing that beats claiming it.
      const fill = (d: string) =>
        `<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">${d}</svg>`;
      // Square caps and miter joins, no rounded corner anywhere: a hard-edged
      // family, deliberately far from both core's round-cap default and the solid
      // set above. An icon swap a viewer cannot see reads as a broken feature.
      const line = (d: string) =>
        `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">${d}</svg>`;
      const ICONS: Record<string, Record<string, () => string>> = {
        // Every icon the demo actually puts on screen: the send button, the
        // paperclip in the composer, copy and retry in the action bar, stop while a
        // turn streams, and check/close on a settled tool call. Three would have
        // left four unchanged, and a tab called "Themes & icons" that only moves
        // three of seven is the kind of half-claim this page spent the day removing.
        //
        // The two sets are deliberately far apart — SOLID versus HAIRLINE — because
        // an icon swap a viewer cannot see reads as a broken feature, not a theme.
        default: {},   // whatever core ships — an empty provider falls back
        solid: {     // filled, chunky, rounded: a product-app feel
          send: () => fill('<path d="M3.4 20.4 21 12 3.4 3.6 3.4 10.2 15 12 3.4 13.8Z"/>'),
          paperclip: () => fill('<path d="M8 5.5a4.5 4.5 0 0 1 9 0V15a3 3 0 0 1-6 0V7.5a1.5 1.5 0 0 1 3 0V15h-1.5V7.5h-.5V15a1.5 1.5 0 0 0 3 0V5.5a3 3 0 0 0-6 0V15a4.5 4.5 0 0 0 9 0V7h1.5v8a6 6 0 0 1-12 0Z"/>'),
          copy: () => fill('<rect x="9" y="9" width="12" height="12" rx="3"/><path d="M6 3h7a3 3 0 0 1 3 3v1h-2V6a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h1v2H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z"/>'),
          retry: () => fill('<path d="M12 4a8 8 0 1 0 7.4 5h-2.2A6 6 0 1 1 12 6V4Z"/><path d="M13 2.5 18 6l-5 3.5Z"/>'),
          stop: () => fill('<rect x="6" y="6" width="12" height="12" rx="3"/>'),
          check: () => fill('<path d="M9.6 16.2 5.4 12l-1.8 1.8 6 6 12-12L19.8 6Z"/>'),
          close: () => fill('<path d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3Z"/>'),
        },
        hard: {      // hard-edged outline: square caps, miter joins, no rounding
          send: () => line('<path d="M3 11l18-8-8 18-2-8-8-2z"/>'),
          paperclip: () => line('<path d="M8 11l7-7a4 4 0 1 1 6 6l-9 9a6 6 0 1 1-8-8l8-8"/>'),
          // Two offset rectangles where the front one OCCLUDES the back one, which
          // is what makes the glyph read as "a copy" rather than as a muddle of
          // crossing lines. It fills with `--aparte-bg` — core's own variable, so
          // the punch-through follows whatever palette the preset picked. (The
          // version this was taken from filled with a variable from another
          // project's stylesheet, which would have rendered black here.)
          copy: () => line('<rect x="4" y="4" width="12" height="14"/><rect x="8" y="6" width="12" height="14" fill="var(--aparte-bg)"/>'),
          retry: () => line('<path d="M4 12a8 8 0 1 1 2.6 5.9"/><path d="M4 20v-6h6"/>'),
          stop: () => line('<rect x="6" y="6" width="12" height="12"/>'),
          check: () => line('<path d="M4 12l5 6 11-14"/>'),
          close: () => line('<path d="M5 5l14 14"/><path d="M19 5L5 19"/>'),
        },
      };

      const SKINS: Record<string, { base: 'page' | 'dark' | 'light'; card?: string; vars: Record<string, string> }> = {
        stage: { base: 'page', vars: {} },
        // These presets used to restate `--aparte-accent`, `--aparte-avatar-bg-user`
        // and `--aparte-border-focus` alongside the master they derive from, and the
        // comment here said that was "the only thing that works". It was: the derived
        // layer was declared on `:root` alone, so it had been substituted there and
        // setting `--aparte-primary` on THIS element could only be inherited past it.
        // That is fixed in core — the layer now re-anchors on `aparte-chat`, among
        // other places — so those three are gone from every preset, and what is left
        // is a master and the handful of genuinely independent choices: a bubble
        // radius, an assistant avatar that derives from a surface rather than the
        // accent, a user bubble.
        violet: { base: 'dark', card: '#15111f', vars: {
          '--aparte-primary': '#7c5cff',
          '--aparte-primary-hover': '#9a80ff',
          '--aparte-avatar-bg-assistant': '#2a2140',
          '--aparte-message-content-bg-user': '#241d3d',
          '--aparte-radius-bubble': '14px',
        } },
        paper: { base: 'light', card: '#f7f3ea', vars: {
          '--aparte-primary': '#8a6d1f',
          '--aparte-primary-hover': '#6f5716',
          '--aparte-avatar-bg-assistant': '#ded2ba',
          '--aparte-bg': '#f7f3ea',
          '--aparte-message-content-bg-user': '#eee4d0',
          '--aparte-radius-bubble': '5px',
        } },
      };
      const SKIN_VARS = [...new Set(Object.values(SKINS).flatMap((s) => Object.keys(s.vars)))];
      const cardEl = document.querySelector('.chat') as HTMLElement | null;
      let skin = 'stage';
      function applySkin(key: string) {
        if (!chatHost) return;
        skin = key;
        const spec = SKINS[key] ?? SKINS.stage;
        const base = spec.base === 'page' ? currentTheme() : spec.base;
        // `light` is the ABSENCE of the attribute — core's default palette is light
        // and only dark is an override.
        if (base === 'dark') chatHost.setAttribute('data-aparte-theme', 'dark');
        else chatHost.removeAttribute('data-aparte-theme');
        for (const v of SKIN_VARS) chatHost.style.removeProperty(v);
        for (const [k, v] of Object.entries(spec.vars)) chatHost.style.setProperty(k, v);
        // The CARD is this page's chrome, not the component's: core paints no
        // background of its own so it can adopt any host surface. Which means a
        // light palette left on a dark card renders dark text on dark — exactly
        // what "Paper" did before this line existed.
        if (cardEl) {
          if (spec.card) cardEl.style.setProperty('--demo-card-bg', spec.card);
          else cardEl.style.removeProperty('--demo-card-bg');
        }
      }
      /** The second lever: a provider object, no CSS involved. */
      let iconSet = 'default';
      function applyIcons(key: string) {
        iconSet = key;
        // An empty provider is the reset: every key is optional and falls back
        // to core's own glyph, so `{}` means "use yours".
        aparteGlobalConfig.setIconProvider(ICONS[key] ?? {});
      }
      /** The third: a plain object of strings. `resetLocale()` is the way back. */
      let localeKey = 'en';
      function applyLocale(key: string) {
        localeKey = key;
        if (key === 'fr') aparteGlobalConfig.setLocale(fr);
        else aparteGlobalConfig.resetLocale();
      }
      /** One select per seam. `change`, not `click`: a select IS the control. */
      const lvPalette = document.getElementById('lvPalette') as HTMLSelectElement;
      const lvIcons = document.getElementById('lvIcons') as HTMLSelectElement;
      const lvLocale = document.getElementById('lvLocale') as HTMLSelectElement;
      lvPalette.addEventListener('change', () => applySkin(lvPalette.value));
      lvIcons.addEventListener('change', () => applyIcons(lvIcons.value));
      lvLocale.addEventListener('change', () => applyLocale(lvLocale.value));
      /** Put the row back in step with what is actually applied. */
      const syncLevers = (): void => {
        lvPalette.value = skin;
        lvIcons.value = iconSet;
        lvLocale.value = localeKey;
      };

      // The page is the host, so it answers the decision core dispatched. This is
      // the whole of what a host owes the built-in approval gate.
      document.addEventListener('aparte-tool-decision', (e) => {
        if (!pending) return;
        const approved = !!(e as any).detail?.approved;
        const { mid, sid } = pending;
        pending = null;
        viewport.updateSegment(mid, sid, approved
          ? { status: 'resolved', result: 'Deleted src/legacy.ts' }
          : { status: 'rejected' });
        const closing = 'tl-end';
        after(() => {
          viewport.addSegment(mid, { id: closing, type: 'text', content: '', isStreaming: true });
          streamSegment(mid, closing, approved
            ? 'Done — the file is gone and the turn carried on from there.'
            : 'Understood, I left it alone. On a rejection the loop injects a “rejected by user” result and stops.',
            () => viewport.completeMessage(mid));
        }, 340);
      });

      // ── panel switching ───────────────────────────────────────────────────
      const RUNNERS: Record<string, () => void> = {
        chat: demoChat, tools: demoTools, segments: demoSegments, artifact: demoArtifact, branch: demoBranch,
      };
      // Measured at build time, handed over on the element (see the comment there).
      const stageEl = document.getElementById('demo')!;
      const N_KINDS = stageEl.dataset.kinds ?? '';
      const N_VARS = stageEl.dataset.vars ?? '';
      const N_LOCALE = stageEl.dataset.locale ?? '';
      const CAPTIONS: Record<string, string> = {
        chat: 'The component itself, streaming token by token — and the composer collecting files, because <b>attachments are one attribute</b> once a host consumes them.',
        tools: 'A tool marked <b>needsApproval</b> pauses the turn. Core draws Approve and Reject and dispatches the decision; press either and watch the turn resume or stop.',
        segments: `One assistant reply holding <b>reasoning and code</b> in the same message. ${N_KINDS} kinds ship registered by default, mixable in any order.`,
        artifact: 'The model wrote a document, and core renders it as a tabbed card. Press <b>Preview</b>: the iframe is sandboxed, its CSP is delivered twice for Firefox and Safari, and it is <b>mounted only by your press</b> — reloading a saved conversation never re-runs what a model wrote.',
        branch: 'Retry <b>forks a sibling</b> instead of overwriting, and the picker appears on its own. Bubble actions stay off until a host answers them.',
      };
      const HINTS: Record<string, string> = {
        chat: 'type below, or attach a file',
        tools: 'press Approve or Reject',
        segments: 'expand the reasoning block',
        artifact: 'press Preview — nothing runs before you do',
        branch: 'hover a reply, press retry',
      };
      const capEl = document.getElementById('demoCap')!;
      const hintEl = document.getElementById('demoHint')!;
      function showDemo(key: string) {
        resetDemo();
        document.querySelectorAll<HTMLElement>('#demoTabs .tab')
          .forEach((t) => t.setAttribute('aria-selected', String(t.dataset.demo === key)));
        document.querySelectorAll<HTMLElement>('.pane')
          .forEach((p) => p.classList.toggle('is-on', p.dataset.pane === key));
        capEl.innerHTML = CAPTIONS[key];
        hintEl.textContent = HINTS[key];
        // The levers KEEP their setting across a tab switch. They used to reset to
        // Stage / Default on every switch, on the reasoning that a visitor should
        // meet the page's own look first — true for the first paint, and wrong for
        // every one after it: picking Violet and then opening the approval panel to
        // see it reset teaches that the palette belongs to one tab. It belongs to the
        // page. `applySkin` still has to RE-run, because a preset writes inline
        // variables on the chat element and this rebuilds the transcript under it.
        applySkin(skin);
        applyIcons(iconSet);
        applyLocale(localeKey);
        syncLevers();
        RUNNERS[key]();
      }
      document.getElementById('demoTabs')?.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest('.tab') as HTMLElement | null;
        if (!t || t.getAttribute('aria-selected') === 'true') return;
        showDemo(t.dataset.demo!);
      });
      showDemo('chat');

      // ── framework code tabs ────────────────────────
      const snippets: Record<string, string> = {
        vanilla:
          '<span class="cm">// nothing to wrap — it’s a web component</span>\n' +
          '<span class="kw">import</span> <span class="st">\'@aparte/core\'</span>;\n\n' +
          '<span class="tg">&lt;aparte-chat&gt;&lt;/aparte-chat&gt;</span>',
        react:
          '<span class="kw">import</span> { AparteChat } <span class="kw">from</span> <span class="st">\'@aparte/react\'</span>;\n\n' +
          '<span class="tg">&lt;AparteChat</span> messages={messages} <span class="tg">/&gt;</span>',
        vue:
          '<span class="kw">import</span> { AparteChat } <span class="kw">from</span> <span class="st">\'@aparte/vue\'</span>;\n\n' +
          '<span class="tg">&lt;AparteChat</span> :messages="messages" <span class="tg">/&gt;</span>',
        svelte:
          '<span class="kw">import</span> { AparteChat } <span class="kw">from</span> <span class="st">\'@aparte/svelte\'</span>;\n\n' +
          '<span class="tg">&lt;AparteChat</span> {messages} <span class="tg">/&gt;</span>',
        angular:
          '<span class="cm">// provideAparte() once at bootstrap, then</span>\n' +
          '<span class="kw">import</span> { AparteChatComponent } <span class="kw">from</span> <span class="st">\'@aparte/angular\'</span>;\n\n' +
          '<span class="tg">&lt;aparte-chat</span> [messages]="messages"<span class="tg">&gt;&lt;/aparte-chat&gt;</span>',
      };
      const snip = document.getElementById('snippet')!;
      const render = (fw: string) => { snip.innerHTML = snippets[fw]; };
      document.getElementById('tabs')?.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest('.tab') as HTMLElement | null; if (!t) return;
        document.querySelectorAll('.tab').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        render(t.dataset.fw!);
      });
      render('vanilla');
    </script>
  </body>
</html>
