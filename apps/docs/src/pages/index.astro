---
/**
 * The home page: what aparté is in one screen, the product running under it, then one section
 * per thing a visitor weighs — the pieces of a chat, the human in the loop, how it fits between
 * a framework and a model, the look, whole apps, and what is checked.
 *
 * Every number comes from src/lib/facts.ts, measured at build time; every demo is the library
 * itself, running in a frame (no screenshot anywhere on the site).
 */
import { arrowRightIcon, checkIcon, copyIcon } from '@aparte/core/icons';
import Variant from '../components/catalog/Variant.astro';
import Code from '../components/content/Code.astro';
import { TabItem, Tabs } from '../components/content/tabs';
import ComponentCarousel from '../components/home/ComponentCarousel.astro';
import HowItFits from '../components/home/HowItFits.astro';
import ProductFrame from '../components/home/ProductFrame.astro';
import WeightChart from '../components/home/WeightChart.astro';
import { REPO_URL } from '../components/site/sections';
import TemplateGrid from '../components/templates/TemplateGrid.astro';
import { LANDING_DESCRIPTION, LANDING_IMAGE_ALT, LANDING_TITLE } from '../data/landing-meta';
import Landing from '../layouts/Landing.astro';
import { BROWSER_ENGINES, COMPONENTS, CORE_THIRD_PARTY_DEPS, CORE_VERSION, TESTS } from '../lib/facts';
import { findTemplate } from '../templates/registry';

const assistant = findTemplate('assistant');
if (!assistant) throw new Error('The home shows the Assistant template, and the registry has none.');

/** The chat pages the carousel shows: one per kind of thing a turn holds, the composer last. */
const MOSAIC = ['message', 'reasoning', 'tool', 'code-block', 'artifact', 'approval', 'question', 'composer'];

/** The same chat in each framework: the first snippet of each framework page, cut to its core. */
const MOUNT = [
    {
        label: 'Vanilla',
        blocks: [
            { lang: 'ts', code: `import '@aparte/core';\nimport '@aparte/core/styles.css';` },
            { lang: 'html', code: `<aparte-chat></aparte-chat>` },
        ],
    },
    {
        label: 'React',
        blocks: [
            {
                lang: 'tsx',
                code: `import { AparteChat, useAparteChat } from '@aparte/react';
import '@aparte/core/styles.css';

export function Chat() {
  const chat = useAparteChat();
  return <AparteChat ref={chat.ref} messages={chat.messages} onMessagesChange={chat.setMessages} />;
}`,
            },
        ],
    },
    {
        label: 'Vue',
        blocks: [
            {
                lang: 'vue',
                code: `<script setup lang="ts">
import { AparteChat, useAparteChat } from '@aparte/vue';
import '@aparte/core/styles.css';

const chat = useAparteChat();
</script>

<template>
  <AparteChat :ref="chat.chatRef" :messages="chat.messages.value" @messages-change="chat.onMessagesChange" />
</template>`,
            },
        ],
    },
    {
        label: 'Svelte',
        blocks: [
            {
                lang: 'svelte',
                code: `<script lang="ts">
  import { AparteChat, createAparteChat, type AparteChatImperativeApi } from '@aparte/svelte';
  import '@aparte/core/styles.css';

  const chat = createAparteChat();
  const { messages } = chat;
  let comp: AparteChatImperativeApi | null = null;
  $: chat.connect(comp);
</script>

<AparteChat bind:this={comp} messages={$messages} onmessagesChange={(m) => chat.onMessagesChange(m)} />`,
            },
        ],
    },
    {
        label: 'Angular',
        blocks: [
            {
                lang: 'ts',
                code: `import { Component } from '@angular/core';
import { AparteChatComponent, type AparteMessage } from '@aparte/angular';
import '@aparte/core/styles.css';

@Component({
  standalone: true,
  imports: [AparteChatComponent],
  template: \`<aparte-chat (messagesChange)="messages = $event"></aparte-chat>\`,
})
export class Chat {
  messages: AparteMessage[] = [];
}`,
            },
        ],
    },
];

const LOOP = [
    { title: 'Approve each tool call', line: 'The call waits, its arguments on screen, until someone allows or rejects it.', href: '/components/approval/' },
    { title: 'Ask the person a question', line: 'The model asks with choices or a short form; the answer stays in the transcript.', href: '/components/question/' },
    { title: 'Decide how much it does alone', line: 'Plan, ask before every change, or act: one switch in the composer.', href: '/components/approval-mode/' },
    { title: 'Keep the loop on your server', line: 'A turn that waits for a person survives a reload and picks up where it stopped.', href: '/guides/server-loop/' },
];

const PROOF = [
    { figure: String(CORE_THIRD_PARTY_DEPS), label: 'third-party dependencies', line: 'in @aparte/core. Markdown, highlighting and the rest are plugins you add.' },
    TESTS
        ? { figure: TESTS.tests.toLocaleString('en-US'), label: 'tests', line: `in ${TESTS.files} files, green on the last run.` }
        : { figure: '1,000+', label: 'tests', line: 'across every package.' },
    { figure: String(BROWSER_ENGINES.length), label: 'browser engines', line: `drive the examples end to end: ${BROWSER_ENGINES.join(', ')}.` },
    { figure: 'axe', label: 'on every example', line: 'an accessibility scan in the end-to-end suite, idle and mid-turn.' },
];
---

<Landing
    title={LANDING_TITLE}
    description={LANDING_DESCRIPTION}
    canonical="https://apartejs.dev/"
    ogImage="https://apartejs.dev/og/index.png"
    ogImageAlt={LANDING_IMAGE_ALT}
>
    <Fragment slot="head">
        {/* What the software IS, for a machine: the library (SoftwareSourceCode, with the product
            it targets nested), then the site, whose `alternateName` carries the string people
            type ("apartejs") while the brand is written "aparté". */}
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'SoftwareSourceCode',
                name: 'aparté',
                description: LANDING_DESCRIPTION,
                url: 'https://apartejs.dev/',
                codeRepository: REPO_URL,
                license: 'https://opensource.org/licenses/MIT',
                programmingLanguage: 'TypeScript',
                targetProduct: {
                    '@type': 'SoftwareApplication',
                    name: '@aparte/core',
                    applicationCategory: 'DeveloperApplication',
                    softwareVersion: CORE_VERSION,
                    operatingSystem: 'Any',
                },
            })}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                name: 'aparté',
                alternateName: ['apartejs', 'aparte'],
                url: 'https://apartejs.dev/',
                description: LANDING_DESCRIPTION,
                publisher: {
                    '@type': 'Organization',
                    name: 'aparté',
                    url: 'https://apartejs.dev/',
                    sameAs: ['https://github.com/apartejs', 'https://www.npmjs.com/org/aparte'],
                },
            })}
        />
    </Fragment>

    <div class="home">
        <section class="home-hero">
            <h1 class="home-hero__title">{COMPONENTS.total} components for AI chat and agents, built as Web Components</h1>
            <p class="home-hero__lede">
                The transcript, the tools, the approvals and the composer of an AI app, streaming any model or agent — in
                React, Vue, Svelte, Angular or vanilla JS, with zero third-party dependencies.
            </p>
            <div class="home-hero__actions">
                <a class="aparte-btn aparte-btn--solid aparte-btn--primary aparte-btn--lg" href="/guides/getting-started/">
                    Get started <span class="home-icon" set:html={arrowRightIcon} />
                </a>
                <a class="aparte-btn aparte-btn--outline aparte-btn--lg" href="/components/">Browse the components</a>
                <div class="home-install">
                <code class="home-install__line"><span class="home-install__prompt" aria-hidden="true">$</span> npm i @aparte/core</code>
                <button class="aparte-btn aparte-btn--ghost aparte-btn--icon aparte-btn--sm home-install__copy" type="button" aria-label="Copy the install command" data-copy="npm i @aparte/core">
                    <span class="home-icon home-install__idle" set:html={copyIcon} />
                    <span class="home-icon home-install__done" set:html={checkIcon} />
                </button>
                </div>
            </div>
        </section>

        <section class="home-fits" aria-labelledby="fits">
            <h2 id="fits" class="home-fits__title">Between your framework and your model</h2>
            <HowItFits />
        </section>

        <section class="home-product" aria-label="The Assistant template, live">
            <ProductFrame meta={assistant} />
        </section>

        <section class="home-band" aria-labelledby="pieces">
            <header class="home-band__head">
                <h2 id="pieces">Every piece of an AI chat</h2>
                <p>
                    {COMPONENTS.chat} chat components, each on its own page with live variants: the transcript, everything a
                    turn can hold, the person in the loop and the composer.
                </p>
            </header>
            <ComponentCarousel only={MOSAIC} label="Chat components" />
            <a class="home-more" href="/components/">All {COMPONENTS.total} components <span class="home-icon" set:html={arrowRightIcon} /></a>
        </section>

        <section class="home-band" aria-labelledby="loop">
            <header class="home-band__head">
                <h2 id="loop">A person stays in the loop</h2>
                <p>An agent that acts asks first. The chat draws every step of that conversation, and the loop keeps it.</p>
            </header>
            <div class="home-split">
                <ul class="home-points">
                    {
                        LOOP.map((point) => (
                            <li>
                                <a href={point.href}>{point.title}</a>
                                <p>{point.line}</p>
                            </li>
                        ))
                    }
                </ul>
                <div class="home-split__demo">
                    <Variant id="approval" />
                </div>
            </div>
        </section>

        <section class="home-band" aria-labelledby="mount">
            <header class="home-band__head">
                <h2 id="mount">Two lines in your framework</h2>
                <p>The same elements in React, Vue, Svelte, Angular or vanilla JS: install the core and place the chat.</p>
            </header>
            <div class="home-mount">
                <Tabs syncKey="framework">
                    {
                        MOUNT.map((framework) => (
                            <TabItem label={framework.label}>
                                {framework.blocks.map((block) => (
                                    <Code code={block.code} lang={block.lang} />
                                ))}
                            </TabItem>
                        ))
                    }
                </Tabs>
                <p class="home-note">
                    The four wrappers are published, typed, and driven in a browser by the same suite as the plain build.
                    <a href="/frameworks/">The framework guides</a> · <a href="/providers/">Models and agents</a>
                </p>
            </div>
        </section>

        <section class="home-band" aria-labelledby="yours">
            <header class="home-band__head">
                <h2 id="yours">Make it yours</h2>
                <p>
                    The same chat three times. Tokens set the palette and the shapes, an icon set and an avatar provider change
                    the glyphs, and since nothing hides in a shadow root, a plain selector reaches the rest.
                </p>
            </header>
            <div class="home-skins">
                <Variant id="home-skin-default" widths={false} />
                <Variant id="home-skin-messenger" widths={false} />
                <Variant id="home-skin-terminal" widths={false} />
            </div>
            <p class="home-note">
                The rest of your app wears the same tokens: a kit of {COMPONENTS.kit} recipes — buttons, fields, menus, dialogs,
                tabs. <a href="/guides/theming/">Theme it</a> · <a href="/components/button/">The kit</a>
            </p>
        </section>

        <section class="home-band" aria-labelledby="templates">
            <header class="home-band__head">
                <h2 id="templates">Start from a template</h2>
                <p>Whole apps built only from aparté, running. Open one, then take its code.</p>
            </header>
            <TemplateGrid />
        </section>

        <section class="home-band" aria-labelledby="checked">
            <header class="home-band__head">
                <h2 id="checked">Checked, not claimed</h2>
                <p>A beta: the public surface is frozen, and a change to it ships with a notice. Every figure here is read from the repository when the site builds.</p>
            </header>
            <div class="home-weight">
                <h3 class="home-weight__title">What a working chat weighs</h3>
                <WeightChart compact />
            </div>
            <dl class="home-proof">
                {
                    PROOF.map((fact) => (
                        <div class="home-proof__fact">
                            <dt>
                                <span class="home-proof__figure">{fact.figure}</span> {fact.label}
                            </dt>
                            <dd>{fact.line}</dd>
                        </div>
                    ))
                }
            </dl>
        </section>

        <section class="home-end" aria-labelledby="start">
            <h2 id="start">Start with one element</h2>
            <p>Install the core, drop a chat in a page, point it at a model.</p>
            <div class="home-hero__actions">
                <a class="aparte-btn aparte-btn--solid aparte-btn--primary aparte-btn--lg" href="/guides/getting-started/">
                    Get started <span class="home-icon" set:html={arrowRightIcon} />
                </a>
                <a class="aparte-btn aparte-btn--outline aparte-btn--lg" href={REPO_URL} target="_blank" rel="noopener">GitHub</a>
            </div>
        </section>
    </div>
</Landing>

<script>
    // The install line's copy button: the command to the clipboard, a check for a moment.
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(button.dataset.copy ?? '');
            } catch {
                return;
            }
            button.dataset.copied = '';
            setTimeout(() => delete button.dataset.copied, 1600);
        });
    }
</script>

<style>
    .home {
        --home-gap: clamp(4rem, 9vw, 7.5rem);
        display: grid;
        gap: var(--home-gap);
        padding-block: clamp(2rem, 4.5vw, 3.25rem) var(--home-gap);
        font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    }
    .home a {
        text-underline-offset: 3px;
    }
    .home-icon {
        display: inline-flex;
        --aparte-icon-size: 1.1em;
    }

    /* ── Hero ─────────────────────────────────────────────────────────── */
    .home-hero {
        display: grid;
        justify-items: center;
        gap: 1.25rem;
        max-width: 58rem;
        margin-inline: auto;
        text-align: center;
    }
    .home-hero__version {
        text-decoration: none;
    }
    .home-hero__title {
        margin: 0;
        color: var(--aparte-text);
        font-size: clamp(2.125rem, 4.6vw, 3.375rem);
        font-weight: 650;
        letter-spacing: -0.03em;
        line-height: 1.05;
        text-wrap: balance;
    }
    .home-hero__lede {
        max-width: 50rem;
        margin: 0;
        color: var(--aparte-text-muted);
        font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
        line-height: 1.55;
        text-wrap: pretty;
    }
    .home-hero__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
    }
    .home-install {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.375rem 0.375rem 1rem;
        border: var(--aparte-border-width, 1px) solid var(--aparte-border);
        border-radius: var(--aparte-radius-full);
        background: var(--aparte-surface-1);
    }
    .home-install__line {
        color: var(--aparte-text);
        font-family: 'Geist Mono Variable', ui-monospace, monospace;
        font-size: 0.9375rem;
    }
    .home-install__prompt {
        color: var(--aparte-primary);
    }
    .home-install__done,
    .home-install__copy[data-copied] .home-install__idle {
        display: none;
    }
    .home-install__copy[data-copied] .home-install__done {
        display: inline-flex;
    }

    /* ── The architecture, then the product, both close under the hero ── */
    .home-fits {
        display: grid;
        gap: 0.75rem;
        width: 100%;
        max-width: 62rem;
        margin: calc(var(--home-gap) * -0.62) auto 0;
        min-width: 0;
    }
    .home-fits__title {
        margin: 0;
        color: var(--aparte-text-muted);
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-align: center;
        text-transform: uppercase;
    }
    /* The weights, in the proof section. */
    .home-weight {
        display: grid;
        gap: 0.5rem;
        width: 100%;
        max-width: 46rem;
        margin-inline: auto;
        min-width: 0;
    }
    .home-weight__title {
        margin: 0;
        color: var(--aparte-text);
        font-size: 1.125rem;
        font-weight: 650;
        text-align: center;
    }
    .home-product {
        margin-block-start: calc(var(--home-gap) * -0.45);
    }

    /* ── Bands ────────────────────────────────────────────────────────── */
    .home-band {
        display: grid;
        gap: 2rem;
        min-width: 0;
    }
    .home-band__head {
        display: grid;
        justify-items: center;
        gap: 0.75rem;
        max-width: 44rem;
        margin-inline: auto;
        text-align: center;
    }
    .home-band__head h2 {
        margin: 0;
        color: var(--aparte-text);
        font-size: clamp(1.75rem, 3.4vw, 2.5rem);
        font-weight: 650;
        letter-spacing: -0.025em;
        line-height: 1.1;
        text-wrap: balance;
    }
    .home-band__head p {
        margin: 0;
        color: var(--aparte-text-muted);
        font-size: 1.0625rem;
        line-height: 1.6;
        text-wrap: pretty;
    }
    /* The templates two by two, large enough to read. */
    @media (min-width: 64rem) {
        .home-band :global(.template-grid) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin: 0;
        }
    }
    .home-more {
        justify-self: center;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        color: var(--aparte-text);
        font-weight: 550;
        text-decoration-color: var(--aparte-primary);
    }
    .home-note {
        margin: 0;
        color: var(--aparte-text-muted);
        font-size: 0.9375rem;
        text-align: center;
    }
    .home-note a {
        color: var(--aparte-text);
        text-decoration-color: var(--aparte-primary);
    }

    /* ── The loop ─────────────────────────────────────────────────────── */
    .home-split {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: center;
    }
    .home-points {
        display: grid;
        gap: 1.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .home-points li {
        display: grid;
        gap: 0.25rem;
        padding-inline-start: 1rem;
        border-inline-start: 2px solid var(--aparte-border);
    }
    .home-points a {
        color: var(--aparte-text);
        font-size: 1.0625rem;
        font-weight: 600;
        text-decoration-color: var(--aparte-primary);
    }
    .home-points p {
        margin: 0;
        color: var(--aparte-text-muted);
        line-height: 1.55;
    }
    .home-split__demo {
        min-width: 0;
    }

    /* ── How it fits ──────────────────────────────────────────────────── */
    .home-mount {
        display: grid;
        gap: 1rem;
        width: 100%;
        max-width: 50rem;
        min-width: 0;
        margin-inline: auto;
    }
    /* A grid item is as wide as its longest line unless told otherwise: without this, the
       framework tabs widened with whichever code they showed. */
    .home-mount > :global(*) {
        min-width: 0;
    }

    /* ── Skins ────────────────────────────────────────────────────────── */
    .home-skins {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    /* ── Proof ────────────────────────────────────────────────────────── */
    .home-proof {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin: 0;
    }
    .home-proof__fact {
        display: grid;
        align-content: start;
        gap: 0.5rem;
        padding: 1.25rem;
        border: var(--aparte-border-width, 1px) solid var(--aparte-border);
        border-radius: var(--aparte-radius-lg);
        background: var(--aparte-surface-1);
    }
    .home-proof dt {
        color: var(--aparte-text-muted);
    }
    .home-proof__figure {
        display: block;
        color: var(--aparte-text);
        font-size: 2rem;
        font-variant-numeric: tabular-nums;
        font-weight: 650;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }
    .home-proof dd {
        margin: 0;
        color: var(--aparte-text-muted);
        font-size: 0.9375rem;
        line-height: 1.5;
    }

    /* ── The end ──────────────────────────────────────────────────────── */
    .home-end {
        display: grid;
        justify-items: center;
        gap: 1rem;
        padding: clamp(2.5rem, 6vw, 4rem) 1.5rem;
        border: var(--aparte-border-width, 1px) solid var(--aparte-border);
        border-radius: var(--aparte-radius-xl);
        background: var(--aparte-surface-1);
        text-align: center;
    }
    .home-end h2 {
        margin: 0;
        color: var(--aparte-text);
        font-size: clamp(1.75rem, 3.4vw, 2.5rem);
        font-weight: 650;
        letter-spacing: -0.025em;
    }
    .home-end p {
        margin: 0 0 0.5rem;
        color: var(--aparte-text-muted);
        font-size: 1.0625rem;
    }

    @media (max-width: 64rem) {
        .home-skins {
            grid-template-columns: minmax(0, 1fr);
            max-width: 32rem;
            margin-inline: auto;
            width: 100%;
        }
        .home-proof {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (max-width: 48rem) {
        .home-split {
            grid-template-columns: minmax(0, 1fr);
        }
        .home-proof {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
