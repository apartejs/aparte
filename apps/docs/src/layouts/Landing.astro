---
import { UMAMI_DOMAINS, UMAMI_SRC, UMAMI_WEBSITE_ID } from '../data/analytics';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteNav from '../components/site/SiteNav.astro';
import { sectionOf } from '../components/site/sections';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import FontPreload from '../components/site/FontPreload.astro';
// The library's sheet, layered (see the file): palette.css reads core's palette, and the
// chrome wears its recipes.
import '../styles/library.css';
import '../styles/palette.css';
import '../styles/code.css';
import '../styles/content.css';
import '../styles/landing.css';
import '../styles/site-frame.css';

/*
 * The frame of every page that is NOT a Starlight one: the home, the roadmap, the models.
 *
 * The header, the navigation drawer and the footer are the very components the docs wear
 * (src/components/site/), so the two families of pages cannot drift: a footer link added
 * once is added everywhere. What is left here is the head — a page that Starlight does not
 * build inherits none of the head Starlight writes — and the theme read before paint.
 */

interface Props {
    /** `<title>`, `og:title`, `twitter:title` — one string, three tags. */
    title: string;
    /** `<meta name="description">` and the two social descriptions. */
    description: string;
    /** ABSOLUTE, with its trailing slash: it is both `<link rel=canonical>` and `og:url`. */
    canonical: string;
    /** Absolute URL of the generated card, e.g. `https://apartejs.dev/og/roadmap.png`.
     *  The card itself is built by `src/pages/og/[...slug].ts`, which builds its map
     *  from the docs collection — neither of these pages is in it, so BOTH are named
     *  in that map by hand. A page passing an `ogImage` with no entry there advertises
     *  a 404, and no guard catches it: check-doc-links.mjs reads `<a href>`, never
     *  `<meta>`. */
    ogImage: string;
    /** What the 1200x630 image SHOWS — written from the og map entry, not from the
     *  meta tags beside it, because astro-og-canvas bakes that entry into the PNG as
     *  pixels. An alt written from the tags describes an image nobody sees. */
    ogImageAlt: string;
}

const { title, description, canonical, ogImage, ogImageAlt } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontPreload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- These pages are Astro pages, not Starlight ones, so they inherit none of the
         head Starlight builds: the landing had NO Open Graph at all, while being the
         most-shared URL of the site. Every link to it rendered as a bare line of text
         in Slack, Discord, LinkedIn and X. The card itself is generated at build time
         like every docs page's (src/pages/og/), so this stays a list of pointers, not
         a second design. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="aparté" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- What a page adds to its own head and no other page needs — the landing's
         JSON-LD is the one caller today. It stays in the page on purpose: it
         describes @aparte/core, not "a page of this site", so pulling it up here
         would either make the roadmap claim to be the library or need a flag saying
         which page is allowed to. -->
    <slot name="head" />

    <!-- `/` is where a crawler looks for the site's icon — so the links live here
         too, not only in the Starlight config (that one covers the docs pages).
         SVG for browsers, .ico as the raster search engines prefer. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script is:inline>
      // Shared light/dark with the Starlight docs: read the SAME localStorage key
      // Starlight uses (`starlight-theme`) and apply `data-theme` before paint, so
      // the choice made on the docs carries over with no flash. The library reads
      // `data-aparte-theme`, and the palette is the library's, so both. The header's
      // theme menu (src/components/site/SiteTheme.astro) owns every later change.
      (() => {
        let stored = '';
        try { stored = localStorage.getItem('starlight-theme') || ''; } catch {}
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.aparteTheme = theme;
      })();
    </script>

    <!-- Self-hosted Umami: cookieless, no personal data, so no consent banner. Built
         sites only, so `astro dev` never files a visit from localhost. The same tag
         is in src/components/Head.astro because THESE pages carry their own head and
         inherit nothing from Starlight; src/data/analytics.ts holds the two values
         once, and names the CSP that has to allow the host. -->
    {import.meta.env.PROD && (
      <script is:inline defer src={UMAMI_SRC} data-website-id={UMAMI_WEBSITE_ID} data-domains={UMAMI_DOMAINS}></script>
    )}
  </head>
  <body>
    <div class="stage-glow" aria-hidden="true"></div>
    <header class="site-frame__header" aria-label="Site"><SiteHeader section={sectionOf(Astro.url.pathname)?.id} /></header>
    <SiteNav hasTree={false} />
    <main class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
