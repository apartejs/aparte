---
/**
 * The n8n chat widget template: the website of Le Fournil, an invented bakery, with n8n's chat
 * widget in the corner — mounted by @aparte/n8n-chat's `createChat`, the call n8n's own widget
 * takes. The chat runs the real n8n runner on a replay of a workflow (replay.ts), or on the
 * visitor's own n8n from the panel. The behaviour is app.ts.
 */
import './n8n-chat.css';
---

<div class="n8n-demo" data-lang="en">
    <div class="nd-site">
        <header class="nd-site__header">
            <a class="nd-logo" href="#nd-top"><span class="nd-logo__mark" aria-hidden="true">🥖</span>Le Fournil</a>
            <nav class="nd-nav" aria-label="Le Fournil">
                <a class="aparte-btn aparte-btn--ghost aparte-btn--sm" href="#nd-breads">Breads</a>
                <a class="aparte-btn aparte-btn--ghost aparte-btn--sm" href="#nd-visit">Visit us</a>
            </nav>
        </header>

        <section class="nd-hero" id="nd-top" aria-labelledby="nd-hero-title">
            <span class="aparte-badge aparte-badge--info">Gluten-free loaves on Fridays and Saturdays</span>
            <h2 class="nd-hero__title" id="nd-hero-title">Bread baked at dawn, every day.</h2>
            <p class="nd-hero__lede">Sourdough, baguettes and croissants, a step from the station. Ask the assistant in the corner what is out of the oven.</p>
        </section>

        <section class="nd-grid" id="nd-breads" aria-label="Breads">
            <div class="aparte-card"><div class="aparte-card__body"><h3 class="nd-card__title">Sourdough</h3><p class="nd-card__text">Three days of slow fermentation, a dark crust.</p></div></div>
            <div class="aparte-card"><div class="aparte-card__body"><h3 class="nd-card__title">Baguettes</h3><p class="nd-card__text">Out of the oven at 7:15, again at noon.</p></div></div>
            <div class="aparte-card" id="nd-visit"><div class="aparte-card__body"><h3 class="nd-card__title">Visit us</h3><p class="nd-card__text">Tuesday to Sunday, 7 am to 7 pm.</p></div></div>
        </section>
    </div>

    <aside class="nd-panel aparte-card" aria-labelledby="nd-panel-title">
        <div class="aparte-card__body nd-panel__body">
            <p class="nd-panel__eyebrow">@aparte/n8n-chat</p>
            <h2 class="nd-panel__title" id="nd-panel-title">n8n’s chat widget, rebuilt</h2>
            <p class="nd-panel__text">
                The same <code>createChat</code> call as <code>@n8n/chat</code>, on a Chat Trigger. Here it replays a real
                workflow; connect yours below.
            </p>

            <div class="nd-control" role="group" aria-label="Language">
                <span class="nd-control__label">Language</span>
                <div class="nd-segmented">
                    <button type="button" class="aparte-btn aparte-btn--sm aparte-btn--outline" data-lang-choice="en" aria-pressed="true">English</button>
                    <button type="button" class="aparte-btn aparte-btn--sm aparte-btn--outline" data-lang-choice="fr" aria-pressed="false">Français</button>
                </div>
            </div>

            <div class="nd-control" role="group" aria-label="Look">
                <span class="nd-control__label">Look</span>
                <div class="nd-segmented">
                    <button type="button" class="aparte-btn aparte-btn--sm aparte-btn--outline" data-look="n8n" aria-pressed="true">n8n</button>
                    <button type="button" class="aparte-btn aparte-btn--sm aparte-btn--outline" data-look="brand" aria-pressed="false">The bakery’s</button>
                    <button type="button" class="aparte-btn aparte-btn--sm aparte-btn--outline" data-look="dark" aria-pressed="false">Dark</button>
                </div>
            </div>

            <form class="nd-connect" novalidate>
                <label class="nd-control__label" for="nd-url">Your n8n</label>
                <div class="nd-connect__row">
                    <input class="aparte-field" id="nd-url" type="url" placeholder="https://…/webhook/…/chat" autocomplete="off" spellcheck="false" aria-describedby="nd-url-hint" />
                    <button type="submit" class="aparte-btn aparte-btn--sm aparte-btn--primary aparte-btn--solid">Connect</button>
                </div>
                <p class="nd-connect__hint" id="nd-url-hint" aria-live="polite">
                    The Chat Trigger’s production URL. In n8n: <em>Embedded Chat</em>, this site in <em>Allowed Origins</em>,
                    streaming on the trigger and on the agent.
                </p>
            </form>

            <a class="aparte-btn aparte-btn--sm aparte-btn--ghost nd-panel__link" href="/integrations/n8n-chat/">Replace @n8n/chat in two lines →</a>
        </div>
    </aside>

    <!-- Where `createChat` mounts: inside the frame, under the page's own `--chat--*` variables. -->
    <div id="nd-chat"></div>
</div>

<script>
    import './app';
</script>
