{
  "name": "@aparte-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "gate": "pnpm check:lockfile && pnpm check:peer-ranges && pnpm lint && pnpm typecheck && pnpm typecheck:tests && pnpm typecheck:matrix && pnpm build && pnpm check:dist-freshness && pnpm test:coverage && pnpm check:coverage-floors && pnpm check-packaging && pnpm check:readmes && pnpm check:node-import && pnpm check:wrapper-slots && pnpm check:examples && pnpm check:attr-escaping && pnpm check:text-escaping && pnpm check:secure-context && pnpm check:segment-stamp && pnpm check:derived-vars && pnpm check:engine-consumer && pnpm check:doc-snippets && pnpm check:export-mentions && pnpm check:node-barrel-types && pnpm check:bundle-entries && pnpm check:event-map && pnpm check:cross-refs && pnpm check:gate-in-ci && pnpm --filter @aparte-workspace/docs build && pnpm check:doc-links && pnpm check:cdn-version",
    "check:readmes": "node scripts/check-published-readmes.mjs",
    "check:node-import": "node scripts/check-node-import.mjs",
    "check:wrapper-slots": "node scripts/check-wrapper-slots.mjs",
    "check:examples": "node scripts/check-element-examples.mjs",
    "check:attr-escaping": "node scripts/check-attr-escaping.mjs",
    "check:text-escaping": "node scripts/check-text-escaping.mjs",
    "check:engine-consumer": "node scripts/check-engine-consumer.mjs",
    "check:doc-snippets": "node scripts/check-doc-snippets.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:cdn-version": "node scripts/check-cdn-version.mjs",
    "check:export-mentions": "node scripts/check-export-mentions.mjs",
    "typecheck:matrix": "pnpm --filter @aparte/react run typecheck:react18",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit && pnpm --filter @aparte/vue --filter @aparte/svelte --filter @aparte/angular run typecheck:tests",
    "gate:full": "pnpm gate && pnpm e2e",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report.json && node scripts/stamp-test-count.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=.vitest-report.json && node scripts/stamp-test-count.mjs",
    "docs": "pnpm --filter @aparte-workspace/docs dev",
    "example:vanilla": "pnpm --filter @aparte-workspace/example-vanilla dev",
    "example:react": "pnpm --filter @aparte-workspace/example-react dev",
    "example:vue": "pnpm --filter @aparte-workspace/example-vue dev",
    "example:svelte4": "pnpm --filter @aparte-workspace/example-svelte4 dev",
    "example:angular": "pnpm --filter @aparte-workspace/example-angular dev",
    "example:vanilla-dist": "pnpm --filter @aparte-workspace/example-vanilla-dist dev",
    "examples:build": "pnpm -r --filter \"@aparte-workspace/example-*\" run build",
    "e2e": "pnpm --filter @aparte-workspace/e2e test",
    "e2e:install": "pnpm --filter @aparte-workspace/e2e install-browser",
    "e2e:ui": "pnpm --filter @aparte-workspace/e2e test:ui",
    "e2e:flake": "pnpm --filter @aparte-workspace/e2e exec playwright test --repeat-each=3",
    "e2e:report": "pnpm --filter @aparte-workspace/e2e report",
    "check-packaging": "pnpm -r --filter \"./packages/**\" exec publint && pnpm -r --filter \"./packages/**\" --filter \"!@aparte/angular\" --filter \"!@aparte/svelte\" --filter \"!@aparte/vue\" exec attw --pack --profile esm-only",
    "lint": "eslint . --max-warnings 0",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-peer-ranges.mjs && node scripts/gen-root-changelog.mjs",
    "release": "pnpm prerelease-checks && pnpm -r --filter \"./packages/**\" run build && changeset publish --tag alpha && node scripts/align-dist-tags.mjs && node scripts/tag-release.mjs",
    "prerelease-checks": "node scripts/prerelease-checks.mjs",
    "check:node-barrel-types": "node scripts/check-node-barrel-types.mjs",
    "check:bundle-entries": "node scripts/check-bundle-entries.mjs",
    "check:secure-context": "node scripts/check-secure-context.mjs",
    "check:segment-stamp": "node scripts/check-segment-stamp.mjs",
    "check:derived-vars": "node scripts/check-derived-vars.mjs",
    "check:dist-freshness": "node scripts/check-dist-freshness.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:peer-ranges": "node scripts/check-peer-ranges.mjs",
    "check:event-map": "node scripts/check-event-map.mjs",
    "check:cross-refs": "node scripts/check-cross-refs.mjs",
    "check:gate-in-ci": "node scripts/check-gate-in-ci.mjs",
    "check:coverage-floors": "node scripts/check-coverage-floors.mjs"
  },
  "devDependencies": {
    "@aparte/core": "workspace:*",
    "@aparte/engine": "workspace:*",
    "@aparte/provider-openai-compat": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.4",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.8.0",
    "@nx/js": "20.3.0",
    "@nx/vite": "20.3.0",
    "@types/node": "20.11.0",
    "@typescript-eslint/utils": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "jiti": "1.21.0",
    "jsdom": "~22.1.0",
    "nx": "20.3.0",
    "publint": "^0.3.21",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "20.11.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "nx"
    ]
  }
}
